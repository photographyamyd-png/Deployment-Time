{
  "name": "glc-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"console.log('\\n  GLC Next.js → http://localhost:3040/  (port 3000 is unused; 500/chunk errors → npm run dev:fresh)\\n')\" && next dev --webpack -p 3040",
    "dev:fresh": "npm run clean && node -e \"console.log('\\n  GLC Next.js → http://localhost:3040/\\n')\" && next dev --webpack -p 3040",
    "dev:turbo": "next dev --turbopack -p 3040",
    "dev:alt": "next dev --webpack -p 3041",
    "dev:webpack": "next dev --webpack -p 3040",
    "build": "next build --webpack",
    "build:fresh": "npm run clean && next build --webpack",
    "build:turbo": "next build --turbopack",
    "start": "next start -p 3040",
    "lint": "eslint . --max-warnings 0",
    "clean": "node -e \"const fs=require('fs');const rm=(p)=>{try{fs.rmSync(p,{recursive:true,force:true});console.log('Removed '+p)}catch(e){}};rm('.next');rm('node_modules/.cache')\""
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "next": "^16.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
