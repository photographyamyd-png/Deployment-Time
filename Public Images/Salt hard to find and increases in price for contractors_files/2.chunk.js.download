 {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n}\n\n@mixin fadeOutAnimation {\n  @keyframes fadeOut {\n    0% {\n      opacity: 1;\n    }\n    100% {\n      opacity: 0;\n    }\n  }\n}\n\n@mixin fadeOutAnimationWithDisplayNone {\n  @keyframes fadeOutWithDisplayNone {\n    0% {\n      opacity: 1;\n    }\n    100% {\n      display: none;\n      opacity: 0;\n    }\n  }\n}\n"],sourceRoot:""}]);var s="jasper-player-live-background-overlay__container--P3m1r",u="jasper-player-live-background-overlay__fadeIn--QCC4H",l="jasper-player-live-background-overlay__background-image--ubkVX";const c=o},3400:(n,t,e)=>{"use strict";e.d(t,{Ay:()=>f,Ec:()=>c,OO:()=>u,kL:()=>l,uX:()=>s});var i=e(1182),r=e.n(i),a=e(2806),o=e.n(a)()(r());o.push([n.id,".jasper-player-live-indicator__text-button--brJ_j{padding:0;border:0;margin:0;background-color:rgba(0,0,0,0);font-weight:bold;color:#fff;transition:color 75ms ease}.jasper-player-live-indicator__live-indicator-out-of-edge--uVNiz .live-indicator-icon{fill:#aeaeae}@media(hover: hover)and (pointer: fine){.jasper-player-live-indicator__live-indicator-out-of-edge--uVNiz:hover{color:#858585}}.live-indicator-icon{fill:#eb0400}.jasper-player-live-indicator__container--IEnKO{display:flex;justify-content:center;align-items:center}.jasper-player--xlarge .jasper-player-live-indicator__text-button--brJ_j{font-size:18px}.jasper-player--xlarge .jasper-player-live-indicator__live-icon--pSLtR{width:44px;height:44px}.jasper-player--large .jasper-player-live-indicator__text-button--brJ_j{font-size:16px}.jasper-player--large .jasper-player-live-indicator__live-icon--pSLtR{width:34px;height:34px}.jasper-player--medium .jasper-player-live-indicator__text-button--brJ_j{font-size:16px}.jasper-player--medium .jasper-player-live-indicator__live-icon--pSLtR{width:34px;height:34px}.jasper-player--small .jasper-player-live-indicator__text-button--brJ_j{font-size:11px}.jasper-player--small .jasper-player-live-indicator__live-icon--pSLtR{width:24px;