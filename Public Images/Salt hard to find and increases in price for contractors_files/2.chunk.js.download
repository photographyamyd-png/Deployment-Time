CE,iBAAA,CACA,wBAAA,CAIJ,gDACE,cAAA",sourcesContent:["@import 'typography-tv';\n\n.container {\n  display: flex;\n  position: relative;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  width: 500px;\n  padding: 6px 45px;\n  border: 8px solid transparent;\n  border-radius: 12px;\n  background-clip: padding-box;\n  text-align: center;\n  font-size: 16px;\n  color: white;\n  transition: ease 200ms;\n\n  /* Device that can hover (Magic Remote from LG TVs) */\n  @media (hover: hover) {\n    &:hover {\n      border: 8px solid rgba(255, 255, 255, 0.2);\n    }\n  }\n\n  &:focus {\n    border: 8px solid rgba(255, 255, 255, 0.5);\n    background-color: rgba(255, 255, 255, 0.95);\n    color: black;\n  }\n\n  &.hidden {\n    opacity: 0;\n  }\n}\n\n.main-title {\n  @include typography-tv(h2);\n}\n\n.live-channel-title {\n  margin-bottom: 20px;\n  font-size: 28px;\n  font-weight: bold;\n}\n\n.live-channel-logo {\n  height: 55px;\n\n  &.focused {\n    border-radius: 4px;\n    background-color: rgb(18, 18, 18);\n  }\n}\n\n.sub-title {\n  font-size: 21px;\n}\n","@mixin typography-tv($type) {\n  font-family: 'Open Sans', sans-serif;\n\n  @if $type == h1 {\n    font-size: 48px;\n    font-weight: bold;\n  } @else if $type == h2 {\n    font-size: 26px;\n    font-weight: bold;\n  } @else if $type == h3 {\n    font-size: 21px;\n    font-weight: bold;\n  } @else if $type == h4 {\n    font-size: 21px;\n    font-weight: normal;\n  } @else if $type == p1 {\n    font-size: 18px;\n    font-weight: normal;\n  } @else if $type == p2 {\n    font-size: 16px;\n    font-weight: normal;\n  }\n}\n\n/* Example usages\n.h1 {\n  @include typography-tv(h1);\n}\n.h2 {\n  @include typography-tv(h2);\n}\n.h3 {\n  @include typography-tv(h3);\n}\n.h4 {\n  @include typography-tv(h4);\n}\n.p1 {\n  @include typography-tv(p1);\n}\n.p2 {\n  @include typography-tv(p2);\n}\n*/\n"],sourceRoot:""}]);var s="jasper-player-info-button-tv__container--Tz8vu",u="jasper-player-info-button-tv__hidden--VvHiN",l="jasper-player-info-button-tv__main-title--CZowd",c="jasper-player-info-button-tv__live-channel-title--D6_0H",f="jasper-player-info-button-tv__live-channel-logo--Z3Hfm",h="jasper-player-info-button-tv__focused--Skfpt",d="jasper-player-info-button-tv__sub-title--eSs5x";const _=o},9976:(n,t,e)=>{"use strict";e.d(t,{$T:()=>c,Ay:()=>w,BD:()=>u,Bu:()=>p,CY:()=>_,Iu:()=>g,KX:()=>d,MU:()=>s,N:()=>m,Qc:()=>f,aD:()=>y,c$:()=>b,iY:()=>h,mY:()=>l,p6:()=>v,q_:()=>A});var i=e(1182),r=e.n(i),a=e(2806),o=e.n(a)()(r());o.push([n.id,'.jasper-player-info-panel-overlay-tv__overlay-container--EIQcK{display:flex;position:absolute;z-index:1;top:0;right:0;bottom:0;left:0;opacity:0;justify-content:center;align-items:flex-start;padding:40px 0;transition:ease 200ms;pointer-events:none}.jasper-player-info-panel-overlay-tv__overlay-container--EIQcK.jasper-player-info-panel-overlay-tv__activeInfoPanel--UIvK8{opacity:1;pointer-events:auto}.jasper-player-info-panel-overlay-tv__info-panel-container--phVhv{display:flex;flex-direction:column;justify-content:center;align-items:center;width:500px;border-radius:12px;background-color:rgba(18,18,18,.75);pointer-events:none}.jasper-player-info-panel-overlay-tv__titles-section--zgS0k{display:block;position:relative;width:100%;padding:6px 45px;border:8px solid rgba(0,0,0,0);border-radius:12px;background-clip:padding-box;background-color:rgba(0,0,0,0);text-align:center;color:#fff}.jasper-player-info-panel-overlay-tv__thumbnail-section--z6dPH{width:100%}.jasper-player-info-panel-overlay-tv__info-section--IQD2l{padding:28px}.jasper-player-info-panel-overlay-tv__main-title--sVtOR{font-family:"Open Sans",sans-serif;font-size:26px;font-weight:bold}.jasper-player-info-panel-overlay-tv__live-channel-title--pbOcz{margin-bottom:20px;font-size:28px;font-weight:bold}.jasper-player-info-panel-overlay-tv__live-channel-logo--VyQxu{height:55px}.jasper-player-info-panel-overlay-tv__sub-title--o5NOI{font-size:21px}.jasper-player-info-panel-overlay-tv__thumbna