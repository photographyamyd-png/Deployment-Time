9px;\n  height: 28px;\n}\n\n.replay-icon {\n  width: 25px;\n  height: 26px;\n}\n\n.background-image {\n  display: block;\n  position: relative;\n  z-index: -1;\n  width: 100%;\n  max-width: 100%;\n  height: 100%;\n  max-height: 100%;\n  margin: 0 auto;\n  object-fit: contain;\n}\n","@mixin fadeInAnimation {\n  @keyframes fadeIn {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n}\n\n@mixin fadeOutAnimation {\n  @keyframes fadeOut {\n    0% {\n      opacity: 1;\n    }\n    100% {\n      opacity: 0;\n    }\n  }\n}\n\n@mixin fadeOutAnimationWithDisplayNone {\n  @keyframes fadeOutWithDisplayNone {\n    0% {\n      opacity: 1;\n    }\n    100% {\n      display: none;\n      opacity: 0;\n    }\n  }\n}\n"],sourceRoot:""}]);var s="jasper-player-end-screen-overlay-tv__container--QRQNi",u="jasper-player-end-screen-overlay-tv__fade-in-transition--EpGO0",l="jasper-player-end-screen-overlay-tv__fadeIn--v7Mee",c="jasper-player-end-screen-overlay-tv__buttons-container--QCazW",f="jasper-player-end-screen-overlay-tv__back-icon--GThXZ",h="jasper-player-end-screen-overlay-tv__replay-icon--ORiHq",d="jasper-player-end-screen-overlay-tv__background-image--p9AHK";const _=o},6327:(n,t,e)=>{"use strict";e.d(t,{Ay:()=>v,Kk:()=>p,M6:()=>l,Pf:()=>d,RK:()=>u,Rv:()=>f,Vd:()=>c,kL:()=>s,mY:()=>_,qG:()=>h});var i=e(1182),r=e.n(i),a=e(2806),o=e.n(a)()(r());o.push([n.id,'.jasper-player-error-button-tv__container--w_QeS{display:none;position:relative;z-index:2;padding:12px 24px;border:8px solid rgba(0,0,0,0);border-radius:16px;margin-bottom:30px;background-clip:padding-box;background-color:#28303b;white-space:nowrap;transition:ease 150ms}.jasper-player-error-button-tv__container--w_QeS::before{content:"";position:absolute;top:0;right:0;bottom:0;left:0;opacity:1;border-radius:16px;background-color:rgba(0,0,0,0);transition:ease 150ms}.jasper-player-error-button-tv__container--w_QeS.jasper-player-error-button-tv__visible--LtDTp{display:flex}.jasper-player-error-button-tv__