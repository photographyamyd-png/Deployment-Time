riables';\n\n.container {\n  display: block;\n  position: absolute;\n  z-index: $debug-overlay-index;\n  top: 4%;\n  left: 4%;\n  overflow-y: auto;\n  width: 92%;\n  height: 92%;\n  background-color: rgba(18, 18, 18, 0.75);\n  pointer-events: auto;\n}\n\n.debug-list {\n  width: 100%;\n  padding: 15px 15px 15px 30px;\n  margin: 0;\n  list-style: none;\n  text-align: left;\n  line-height: 1.5;\n  color: #fff;\n}\n\n.debug-item {\n  display: flex;\n  display: -webkit-box; /* stylelint-disable-line */\n  display: -ms-flexbox; /* stylelint-disable-line */\n  position: relative;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px 16px;\n  border-radius: 8px;\n  margin: 0 0 10px;\n  font-size: 24px;\n  user-select: text;\n\n  &:focus {\n    background-color: rgba(255, 255, 255, 0.15);\n  }\n\n  &:last-child {\n    margin: 0;\n  }\n\n  .fake-button {\n    padding: 8px 20px;\n    margin: 0 12px;\n    background-color: rgba(0, 0, 0, 0.75);\n    color: white;\n  }\n}\n\n.debug-item-text {\n  display: block;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: pre-wrap;\n  -webkit-box-orient: vertical; /* stylelint-disable-line */\n  -webkit-line-clamp: 3;\n  line-clamp: 3;\n  word-wrap: break-word;\n}\n\n.debug-modal {\n  display: flex;\n  display: -webkit-box; /* stylelint-disable-line */\n  display: -ms-flexbox; /* stylelint-disable-line */\n  position: fixed;\n  z-index: $debug-overlay-index + 1;\n  top: 4%;\n  left: 4%;\n  flex-direction: column;\n  width: 92%;\n  height: 92%;\n  padding: 30px;\n  background-color: rgba(18, 18, 18);\n  font-size: 20px;\n  color: #fff;\n\n  &-title {\n    font-size: 32px;\n    font-weight: bold;\n  }\n\n  &-remote-instructions {\n    margin: 20px 0 40px;\n    font-style: italic;\n  }\n\n  &-content {\n    transform: scale(1) !important;\n    overflow-y: auto;\n    padding: 20px;\n    border-radius: 12px;\n    margin: 0;\n    white-space: pre-wrap;\n\n    &:focus {\n      background-color: rgba(255, 255, 2