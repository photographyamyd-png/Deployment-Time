85;\n        }\n\n        .text {\n          color: #858585;\n        }\n\n        .thumbnail {\n          transform: none;\n        }\n\n        .upsell-container {\n          background-color: #fff;\n          color: #000;\n        }\n      }\n    }\n  }\n}\n\n.content {\n  display: flex;\n  align-self: stretch;\n  flex-direction: column;\n  justify-content: space-around;\n  padding: 0 40px;\n}\n\n.thumbnail-container {\n  display: flex;\n  position: relative;\n  justify-content: center;\n  align-items: center;\n  padding-left: 40px;\n}\n\n.thumbnail {\n  width: 294px;\n  min-width: 294px;\n  height: 167px;\n  min-height: 167px;\n  transition: 300ms ease transform;\n  object-fit: cover;\n}\n\n.title {\n  font-size: 22px;\n  color: #858585;\n  transition: 300ms ease color;\n}\n\n/* stylelint-disable */\n.text {\n  display: -webkit-box;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  font-size: 18px;\n  color: #858585;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 3;\n  line-clamp: 3;\n  transition: 300ms ease color;\n}\n\n/* stylelint-enable */\n\n.authentication-icon {\n  position: absolute;\n  width: 44px;\n  height: 44px;\n}\n\n.upsell-container {\n  position: absolute;\n  padding: 2px 6px;\n  border-radius: 4px;\n  margin: 16px;\n  background-color: #000;\n  text-align: center;\n  font-size: 13px;\n  font-weight: 700;\n  color: #fff;\n  transition: 300ms ease;\n}\n\n.web-on-mobile-text {\n  display: none;\n}\n\n.web-on-mobile-thumbnail {\n  width: 70px;\n  min-width: 70px;\n  height: 40px;\n  min-height: 40px;\n  padding-left: 13px;\n}\n\n:global(.jasper-player--large) {\n  .row {\n    margin: 20px 0;\n\n    &:first-child {\n      margin-top: 0;\n    }\n  }\n\n  .content {\n    padding: 0 20px;\n  }\n\n  .thumbnail-container {\n    padding-left: 20px;\n  }\n\n  .thumbnail {\n    width: 169px;\n    min-width: 169px;\n    height: 96px;\n    min-height: 96px;\n  }\n\n  .title {\n    font-size: 14px;\n  }\n\n  .text {\n    font-size: 12px;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .row {\n    margin: 20px 0;\n\n    &:first-child {\n      margin-top: 0;\n    }\n  }\n\n  .content {\n    padding: 0 20px;\n  }\n\n  .thumbnail-container {\n    padding-left: 20px;\n  }\n\n  .thumbnail {\n    width: 169px;\n    min-width: 169px;\n    height: 96px;\n    min-height: 96px;\n  }\n\n  .title {\n    font-size: 14px;\n  }\n\n  .upsell-container {\n    font-size: 12px;\n  }\n\n  .text {\n    font-size: 12px;\n  }\n}\n\n:global(.jasper-player--small) {\n  .row {\n    margin: 8px 0;\n\n    &:first-child {\n      margin-top: 0;\n    }\n  }\n\n  .content {\n    padding: 0 10px;\n  }\n\n  .thumbnail-container {\n    padding-left: 13px;\n  }\n\n  .thumbnail {\n    width: 70px;\n    min-width: 70px;\n    height: 40px;\n    min-height: 40px;\n  }\n\n  .title {\n    font-size: 12px;\n  }\n\n  .upsell-container {\n    font-size: 10px;\n  }\n\n  .text {\n    display: none;\n  }\n}\n\n:global(.jasper-player--mini) {\n  .row {\n    margin: 8px 0;\n\n    &:first-child {\n      margin-top: 0;\n    }\n  }\n\n  .content {\n    padding: 0 10px;\n  }\n\n  .thumbnail-container {\n    padding-left: 13px;\n  }\n\n  .thumbnail {\n    width: 70px;\n    min-width: 70px;\n    height: 40px;\n    min-height: 40px;\n  }\n\n  .title {\n    font-size: 12px;\n  }\n\n  .upsell-container {\n    font-size: 10px;\n  }\n\n  .text {\n    display: none;\n  }\n}\n"],sourceRoot:""}]);var s="jasper-player-episode-list-item__row--N56IM",u="jasper-player-episode-list-item__title--yoBLK",l="jasper-player-episode-list-item__text--I7jEK",c="jasper-player-episode-list-item__thumbnail--u570r",f="jasper-player-episode-list-item__row-selected--_OG2H",h="jasper-player-episode-list-item__row-disabled--uLnrX",d="jasper-player-episode-list-item__upsell-container--K_Gxx",_="jasper-player-episode-list-item__content--Ef8NG",p="jasper-player-episode-list-item__thumbnail-container--wTlfh",v="jasper-player-episode-list-item__authentication-icon--I3Zw5",A="jasper-player-episode-lis