justify-content: center;\n  align-items: center;\n  border-radius: 50%;\n  margin-right: 14px;\n  background-color: transparent;\n  cursor: pointer;\n  pointer-events: auto;\n\n  &.hidden {\n    opacity: 0;\n  }\n}\n\n%button-base {\n  display: flex;\n  position: relative;\n  justify-content: center;\n  align-items: center;\n  width: 80px;\n  height: 80px;\n  padding: 13px;\n  border: 8px solid transparent;\n  border-radius: 50%;\n  background-clip: padding-box;\n  background-color: rgba(18, 18, 18, 0.75);\n  color: #000;\n  transition: ease 200ms;\n\n  &::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    opacity: 1;\n    border: 2px solid #2f2f2f;\n    border-radius: 50%;\n    background-color: transparent;\n    transition: ease 200ms;\n  }\n\n  /* Device that can hover (Magic Remote from LG TVs) */\n  @media (hover: hover) {\n    &:hover {\n      border: 8px solid rgba(255, 255, 255, 0.2);\n    }\n  }\n}\n\n%button-focus-base {\n  border: 8px solid rgba(255, 255, 255, 0.5);\n  background-color: #fff;\n\n  :global(.icon-button-fill-hover-color) {\n    fill: currentColor !important;\n  }\n  :global(.icon-button-stroke-hover-color) {\n    stroke: currentColor !important;\n  }\n\n  &::before {\n    opacity: 0;\n  }\n}\n\n/* stylelint-disable */\n%button-focus {\n  &.focused {\n    @extend %button-focus-base;\n  }\n}\n\n%ad-button-focus {\n  &:focus {\n    @extend %button-focus-base;\n  }\n}\n\n.button {\n  @extend %button-base;\n  @extend %button-focus;\n}\n\n.ad-button {\n  @extend %button-base;\n  @extend %ad-button-focus;\n}\n"],sourceRoot:""}]);var s="jasper-player-seek-bar-play-pause-button-tv__container--ZVrlj",u="jasper-player-seek-bar-play-pause-button-tv__hidden--RNcQ2",l="jasper-player-seek-bar-play-pause-button-tv__ad-button--pGAAO",c="jasper-player-seek-bar-play-pause-button-tv__button--l6ZJ3",f="jasper-player-seek-bar-play-pause-button-tv__focused--eileY";const h=o},920:(n,t,e)=>{"use strict