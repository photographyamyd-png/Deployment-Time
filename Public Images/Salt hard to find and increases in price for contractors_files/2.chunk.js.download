xt-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  max-width: 800px;\n  padding: 0 30px;\n  text-align: center;\n}\n\n.button-container {\n  margin-top: 15px;\n}\n\n.title {\n  display: none;\n  font-size: 26px;\n  font-weight: bold;\n  line-height: 1.17;\n  color: #fff;\n\n  &.visible {\n    display: block;\n  }\n}\n\n.message {\n  display: none;\n  margin-top: 9px;\n  font-size: 16px;\n  line-height: 1.15;\n  color: #aeaeae;\n\n  &.visible {\n    display: block;\n  }\n}\n\n.sign-in-button {\n  display: none;\n  padding: 7px 12px;\n  border: transparent;\n  border-color: #454545;\n  border-radius: 4px;\n  margin-top: 15px;\n  background-color: #454545;\n  color: #fff;\n\n  transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out,\n    border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      border-color: #363636;\n      background-color: #363636;\n      color: #fff;\n    }\n  }\n\n  &:active {\n    border-color: #363636;\n    background-color: #363636;\n    color: #fff;\n  }\n\n  &.visible {\n    display: block;\n  }\n}\n\n:global(.jasper-player--xlarge) {\n  .error-icon {\n    width: 130px;\n    height: 130px;\n  }\n}\n\n:global(.jasper-player--large) {\n  .error-icon {\n    width: 100px;\n    height: 100px;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .error-icon {\n    width: 100px;\n    height: 100px;\n  }\n}\n\n:global(.jasper-player--small) {\n  .error-icon {\n    width: 64px;\n    height: 64px;\n  }\n\n  .text-container {\n    padding: 0 10px;\n  }\n\n  .message {\n    margin-top: 5px;\n    font-size: 16px;\n  }\n\n  .sign-in-button {\n    margin-top: 10px;\n    font-size: 13px;\n  }\n}\n\n:global(.jasper-player--mini) {\n  .error-icon {\n    width: 48px;\n    height: 48px;\n  }\n\n  .message {\n    margin: 0 5px;\n    font-size: 12px;\n  }\n\n  .text-container {\n    padding: 0;\n  }\n\n 