5px 5px 0;\n  background-image: linear-gradient(to right, #000 0%, #000 100%);\n\n  &.only-info {\n    border-radius: 5px;\n  }\n}\n\n.countdown {\n  color: #858585;\n}\n\n.countdown-timer {\n  position: relative;\n}\n\n.sign-in-button {\n  padding: 10px 20px;\n  border: transparent;\n  border-color: #fff;\n  border-radius: 6px;\n  background-color: #fff;\n  white-space: nowrap;\n  color: #000;\n\n  transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out,\n    border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      background-image: linear-gradient(rgba(0, 0, 0, 0.1) 0 0);\n    }\n  }\n}\n\n.bottom {\n  display: flex;\n  align-items: center;\n  height: 100%;\n  margin-bottom: 5px;\n  color: #fff;\n}\n\n.title {\n  display: -webkit-box; /* stylelint-disable-line */\n  overflow: hidden;\n  text-overflow: ellipsis;\n  font-weight: bold;\n  -webkit-box-orient: vertical; /* stylelint-disable-line */\n  -webkit-line-clamp: 2;\n}\n\n.subtitle {\n  display: -webkit-box; /* stylelint-disable-line */\n  overflow: hidden;\n  text-overflow: ellipsis;\n  -webkit-box-orient: vertical; /* stylelint-disable-line */\n  -webkit-line-clamp: 1;\n}\n\n.close-button {\n  position: absolute;\n  top: 0;\n  right: 0;\n  border: 0;\n  margin: 0;\n  background-color: transparent;\n  color: #00c1f3;\n  appearance: none;\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      :global(.icon-button-fill-hover-color) {\n        fill: currentColor !important;\n      }\n    }\n  }\n}\n\n.play {\n  position: absolute;\n  top: 50%;\n  left: 54%;\n  transform: translate(-50%, -50%);\n}\n\n.playIcon {\n  width: 20px;\n  height: 20px;\n}\n\n:global(.jasper-player--xlarge) {\n  .container {\n    right: 52px;\n    bottom: 190px;\n    max-width: 690px;\n    height: 140px;\n\n    &.standard {\n      transform: translateY(130px);\n      transition: transform 300ms ease;\n    }\n  }\n\n  .thumbnail {\n    width: 244px;\n  }\n\n  .info {\n    padding: 0 29px;\n  }\n\n  .countdown {\n    margin-top: 22px;\n    font-size: 16px;\n    line-height: 1.63;\n    letter-spacing: 1.6px;\n  }\n\n  .countdown-timer {\n    margin-right: 20px;\n  }\n\n  .title {\n    font-size: 18px;\n    line-height: 1.34;\n    letter-spacing: 0.18px;\n  }\n\n  .subtitle {\n    font-size: 17px;\n    letter-spacing: 0.18px;\n  }\n\n  .sign-in-button {\n    margin-right: 20px;\n    font-size: 22px;\n    line-height: 1.18;\n  }\n\n  .close-button {\n    padding: 10px 6px;\n  }\n\n  .close-button-icon {\n    width: 44px;\n    height: 44px;\n  }\n}\n\n:global(.jasper-player--large) {\n  .container {\n    right: 40px;\n    bottom: 120px;\n    max-width: 537.8px;\n    height: 117.2px;\n\n    &.standard {\n      transform: translateY(90px);\n      transition: transform 300ms ease;\n    }\n  }\n\n  .thumbnail {\n    width: 204.3px;\n  }\n\n  .info {\n    padding: 0 24px;\n  }\n\n  .countdown {\n    margin-top: 22px;\n    font-size: 11px;\n    line-height: 1.09;\n    letter-spacing: 1.1px;\n  }\n\n  .countdown-timer {\n    margin-right: 13px;\n  }\n\n  .title {\n    font-size: 17px;\n    line-height: 1.3;\n  }\n\n  .subtitle {\n    font-size: 12px;\n  }\n\n  .sign-in-button {\n    margin-right: 18px;\n    font-size: 14px;\n    line-height: 1.14;\n  }\n\n  .close-button {\n    padding: 12px 6px 0 0;\n  }\n\n  .close-button-icon {\n    width: 28px;\n    height: 28px;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .container {\n    right: 40px;\n    bottom: 120px;\n    max-width: 537.8px;\n    height: 117.2px;\n\n    &.standard {\n      transform: translateY(90px);\n      transition: transform 300ms ease;\n    }\n  }\n\n  .thumbnail {\n    width: 204.3px;\n  }\n\n  .info {\n    padding: 0 24px;\n  }\n\n  .countdown {\n    margin-top: 22px;\n    font-size: 11px;\n    line-height: 1.09;\n    letter-spacing: 1.1px;\n  }\n\n  .countdown-timer {\n    margin-right: 13px;\n  }\n\n  .title {\n    font-size: 17px;\n    line-height: 1.3;\n  }\n\n  .subtitle {\n    font-size: 12px;\n  }\n\n  .sign-in-button {\n    margin-right: 18px;\n    font-size: 14px;\n    line-height: 1.14;\n  }\n\n  .close-button {\n    padding: 12px 6px 0 0;\n  }\n\n  .close-button-icon {\n    width: 28px;\n    height: 28px;\n  }\n}\n\n:global(.jasper-player--small) {\n  .container {\n    z-index: $up-next-overlay-small-index;\n    right: 20px;\n    bottom: 60px;\n    max-width: 268.4px;\n    height: 57px;\n\n    &.standard {\n      transform: translateY(43px);\n      transition: transform 300ms ease;\n    }\n  }\n\n  .thumbnail {\n    width: 0;\n  }\n\n  .info {\n    display: flex;\n    justify-content: center;\n    padding: 0 45px 0 16px;\n    border-radius: 5px;\n  }\n\n  .countdown {\n    display: none;\n  }\n\n  .countdown-timer {\n    margin-right: 15px;\n  }\n\n  .bottom {\n    margin-bottom: 0;\n  }\n\n  .title {\n    font-size: 11px;\n    letter-spacing: 0.11px;\n  }\n\n  .subtitle {\n    margin-top: 2px;\n    font-size: 10px;\n    letter-spacing: 0.11px;\n  }\n\n  .sign-in-button {\n    margin-right: 12px;\n    font-size: 12px;\n    line-height: 1.17;\n  }\n\n  .close-button {\n    margin-top: 10px;\n  }\n\n  .close-button-icon {\n    width: 36px;\n    height: 36px;\n  }\n}\n\n:global(.jasper-player--mini) {\n  .container {\n    z-index: $up-next-overlay-small-index;\n    right: 20px;\n    bottom: 60px;\n    max-width: 268.4px;\n    height: 57px;\n\n    &.standard {\n      transform: translateY(43px);\n      transition: transform 300ms ease;\n    }\n  }\n\n  .thumbnail {\n    width: 0;\n  }\n\n  .info {\n    display: flex;\n    justify-content: center;\n    padding: 0 45px 0 16px;\n    border-radius: 5px;\n  }\n\n  .countdown {\n    display: none;\n  }\n\n  .countdown-timer {\n    margin-right: 15px;\n  }\n\n  .bottom {\n    margin-bottom: 0;\n  }\n\n  .title {\n    font-size: 11px;\n    letter-spacing: 0.11px;\n