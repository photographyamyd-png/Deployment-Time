6px;\n  border: 4px solid transparent;\n  border-radius: 12px;\n  background-color: #000;\n  transition: all 500ms cubic-bezier(0.25, 0.1, 0.25, 1);\n  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);\n\n  &:focus {\n    transform: scale(1.05);\n    border: 4px solid rgb(255, 255, 255);\n    color: black;\n  }\n}\n\n.thumbnail {\n  width: 384px;\n  height: 216px;\n  background: #fff;\n}\n\n.dark-gradient-background {\n  display: flex;\n  position: absolute;\n  top: 0;\n  left: 0;\n  justify-content: center;\n  align-items: center;\n  width: 384px;\n  height: 216px;\n  background: rgba(0, 0, 0, 0.75);\n}\n\n.now-playing-text {\n  padding: 8px 16px;\n  border-radius: 4px;\n  background-color: #000;\n  font-size: 21px;\n  font-weight: 700;\n  color: #fff;\n  transition: all ease 200ms;\n\n  &.focused {\n    background-color: #fff;\n    color: #000;\n  }\n}\n\n.locked-content-container {\n  display: flex;\n  align-items: center;\n  padding: 8px 16px;\n  border-radius: 4px;\n  background-clip: padding-box;\n  background-color: #000;\n  font-size: 21px;\n  font-weight: 700;\n  color: #fff;\n  transition: ease 200ms;\n\n  &.focused {\n    background-color: #fff;\n    color: #000;\n  }\n}\n\n.locked-content-icon {\n  width: auto;\n  height: 18px;\n  padding-right: 12px;\n\n  :global(.icon-button-fill-hover-color) {\n    fill: currentColor !important;\n  }\n}\n\n.title {\n  display: -webkit-box; /* stylelint-disable-line */\n  overflow: hidden;\n  margin-top: 16px;\n  text-overflow: ellipsis;\n  font-size: 24px;\n  font-weight: 700;\n  color: #fff;\n  -webkit-box-orient: vertical; /* stylelint-disable-line */\n  -webkit-line-clamp: 3;\n}\n\n.schedule {\n  margin-top: 8px;\n  font-size: 24px;\n  font-weight: 500;\n  line-height: 32px;\n  color: #fff;\n}\n\n.channel-container {\n  position: absolute;\n  top: 16px;\n  left: 16px;\n  max-width: 352px;\n  padding: 2px 4px;\n  border-radius: 4px;\n  background-color: #000;\n  font-size: 21px;\n  font-weight: 700;\n  color: #fff;\n}\n\n.channel-logo {\n  position: absolute;\n  top: 16px;\n  left: 16px;\n  height: 35px;\n  border-radius: 4px;\n  background-color: #000;\n}\n"],sourceRoot:""}]);var s="jasper-player-carousel-tile-tv__container--T2KTm",u="jasper-player-carousel-tile-tv__thumbnail-container--kjnEK",l="jasper-player-carousel-tile-tv__thumbnail--f5G7T",c="jasper-player-carousel-tile-tv__dark-gradient-background--GSRk6",f="jasper-player-carousel-tile-tv__now-playing-text--qnsjK",h="jasper-player-carousel-tile-tv__focused--rhjkr",d="jasper-player-carousel-tile-tv__locked-content-container--HSgB_",_="jasper-player-carousel-tile-tv__locked-content-icon--C2wMw",p="jasper-player-carousel-tile-tv__title--T1JPq",v="jasper-player-carousel-tile-tv__schedule--JA1zK",A="jasper-player-carousel-tile-tv__channel-container--ThXmZ",m="jasper-player-carousel-tile-tv__channel-logo--F3Uly";const g=o},9580:(n,t,e)=>{"use strict";e.d(t,{Ay:()=>c,Qs:()=>u,Vs:()=>l,kL:()=>s});var i=e(1182),r=e.n(i),a=e(2806),o=e.n(a)()(r());o.push([n.id,".jasper-player-carousel-tv__container--Xmcd5{position:relative}.jasper-player-carousel-tv__content--si1mh{display:flex;flex-wrap:nowrap;width:-moz-fit-content;width:fit-content;pointer-events:auto}.jasper-player-carousel-tv__tile--FL4Ii{flex:0 0 384px}","",{version:3,sources:["webpack://./kotlin/styles/tv/carousel-tv.module.scss"],names:[],mappings:"AAAA,6CACE,iBAAA,CAGF,2CACE,YAAA,CACA,gBAAA,CACA,sBAAA,CAAA,iBAAA,CACA,mBAAA,CAGF,wCACE,cAAA",sourcesContent:[".container {\n  position: relative;\n}\n\n.content {\n  display: flex;\n  flex-wrap: nowrap;\n  width: fit-content;\n  pointer-events: auto;\n}\n\n.tile {\n  flex: 0 0 384px;\n}\n"],sourceRoot:""}]);var s="jasper-player-carousel-tv__container--Xmcd5",u="jasper-player-carousel-tv__content--si1mh",l="jasper-player-carousel-tv__tile--FL4Ii";const c=o},8992:(n,t,e)=>{"use strict";e.d(t,{Ay:()=>p,C1:()=>_,Kk:()=>h,R:()=>u,Vk:()=>c,kL:()=>s,lU:()=>l,o4:()=>d,wy:()=>f});var i=e(1182),r=e.n(i),a=e(2806),o=e.n(a)()(