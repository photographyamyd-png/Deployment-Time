l: currentColor !important;\n      }\n    }\n  }\n}\n\n.close-button-icon {\n  width: 44px;\n  height: 44px;\n}\n\n:global(.jasper-player--xlarge) {\n  .container {\n    min-height: 300px;\n\n    &.fixed-height {\n      min-height: 60%;\n      max-height: 60%;\n    }\n  }\n\n  .close-button {\n    padding: 17px;\n  }\n\n  .wrapper {\n    right: 40px;\n    bottom: 125px;\n  }\n\n  .container {\n    min-width: 400px;\n    max-width: 650px;\n  }\n}\n\n:global(.jasper-player--large) {\n  .container {\n    min-height: 225px;\n\n    &.fixed-height {\n      min-height: 80%;\n      max-height: 80%;\n    }\n  }\n\n  .close-button {\n    padding: 9px;\n  }\n\n  .wrapper {\n    right: 20px;\n    bottom: 85px;\n  }\n\n  .container {\n    min-width: 250px;\n    max-width: 385px;\n  }\n\n  .close-button-icon {\n    width: 29px;\n    height: 29px;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .container {\n    min-height: 225px;\n\n    &.fixed-height {\n      min-height: 80%;\n      max-height: 80%;\n    }\n  }\n\n  .close-button {\n    padding: 9px;\n  }\n\n  .wrapper {\n    right: 20px;\n    bottom: 85px;\n  }\n\n  .container {\n    min-width: 250px;\n    max-width: 410px;\n  }\n\n  .close-button-icon {\n    width: 29px;\n    height: 29px;\n  }\n}\n\n:global(.jasper-player--small) {\n  .overlay {\n    height: 76%;\n  }\n\n  .container {\n    &.fixed-height {\n      min-height: 88%;\n      max-height: 88%;\n    }\n\n    &.web-on-mobile-fixed-height {\n      min-height: 30%;\n      max-height: 30%;\n    }\n  }\n\n  .close-button {\n    padding: 5px;\n  }\n\n  .wrapper {\n    right: 18px;\n    bottom: 35px;\n  }\n\n  .container {\n    min-width: 185px;\n    max-width: 280px;\n  }\n\n  .close-button-icon {\n    width: 21px;\n    height: 21px;\n  }\n}\n\n:global(.jasper-player--mini) {\n  .overlay {\n    height: 76%;\n  }\n\n  .container {\n    &.fixed-height {\n      min-height: 88%;\n      max-height: 88%;\n    }\n\n    &.web-on-mobile-fixed-height {\n      min-height: 30%;\n    