h: fit-content;\n  margin-bottom: 0;\n}\n\n.subtitle {\n  margin-bottom: 0;\n}\n\n:global(.jasper-player--xlarge) {\n  .container {\n    top: 60px;\n    left: 60px;\n  }\n\n  .title {\n    margin-bottom: 11px;\n    @include typography(xlarge, h1);\n    line-height: 1.15;\n  }\n\n  .subtitle {\n    font-size: 22px;\n    line-height: 1.18;\n  }\n}\n\n:global(.jasper-player--large) {\n  .container {\n    top: 40px;\n    left: 40px;\n  }\n\n  .title {\n    margin-bottom: 11px;\n    @include typography(large, h1);\n    line-height: 1.15;\n  }\n\n  .subtitle {\n    font-size: 14px;\n    line-height: 1.18;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .container {\n    top: 40px;\n    left: 40px;\n  }\n\n  .title {\n    margin-bottom: 11px;\n    @include typography(medium, h1);\n    line-height: 1.15;\n  }\n\n  .subtitle {\n    font-size: 14px;\n    line-height: 1.18;\n  }\n}\n\n:global(.jasper-player--small) {\n  .container {\n    top: 20.5px;\n    left: 19px;\n  }\n\n  .title {\n    margin-bottom: 5px;\n    @include typography(small, h1);\n    line-height: 1.14;\n  }\n\n  .subtitle {\n    font-size: 12px;\n    line-height: 1.17;\n  }\n}\n\n:global(.jasper-player--mini) {\n  .container {\n    top: 20.5px;\n    left: 19px;\n  }\n\n  .title {\n    margin-bottom: 5px;\n    @include typography(mini, h1);\n    line-height: 1.14;\n  }\n\n  .subtitle {\n    font-size: 12px;\n    line-height: 1.17;\n  }\n}\n","$ad-break-overlay-index: 2;\n$banner-ad-overlay-index: 3;\n$blackout-overlay-index: 5;\n$cast-overlay-index: 1;\n$debug-overlay-index: 16;\n$end-screen-overlay-index: 2;\n$error-overlay-index: 11;\n$loading-overlay-index: 10;\n$pause-ad-overlay-index: 2;\n$popover-dialog-overlay-index: 4;\n$preview-overlay-index: 10;\n$skip-breaks-overlay-index: 2;\n$text-track-styling-overlay-index: 5;\n$toast-overlay-index: 14;\n$tv-channel-switcher-index: 3;\n$tv-dynamic-button-index: 2;\n$tv-panel-overlay-index: 1;\n$up-next-overlay-index: 2;\n$up-next-overlay-small-index: 3;\n$performance-overlay-index: 15;\n\n$airplay-button-index: 3;\n$cast-button-index: 3;\n$center-controls-index: 4;\n$controls-index: 3;\n$loading-indicator-index: 10;\n$seek-bar-index: 1;\n$seek-bar-tooltip-index: 11;\n$tooltip-index: 3;\n$volume-slider-index: 2;\n$title-index: 3;\n\n$close-float-button-index: 3;\n$float-index: 9999;\n$overlay-focus-index: 9999;\n\n$bell-blue: #0066a4;\n\n$tv-horizontal-margins: 7.5%;\n","// When looking at the designs xlarge -> large, large -> medium, medium -> small, and small -> mini and mini is basically a copy of small\n$font-sizes: (\n  xlarge: (\n    h1: 27px,\n    h2: 22px,\n    h3: 16px,\n    p1: 18px,\n    p2: 18px,\n    p3: 16px\n  ),\n  large: (\n    h1: 17px,\n    h2: 14px,\n    h3: 11px,\n    p1: 16px,\n    p2: 12px,\n    p3: 14px\n  ),\n  medium: (\n    h1: 17px,\n    h2: 14px,\n    h3: 11px,\n    p1: 16px,\n    p2: 12px,\n    p3: 14px\n  ),\n  small: (\n    h1: 14px,\n    h2: 12px,\n    h3: 8px,\n    p1: 11px,\n    p2: 11px,\n    p3: 8px\n  ),\n  mini: (\n    h1: 14px,\n    h2: 12px,\n    h3: 8px,\n    p1: 11px,\n    p2: 11px,\n    p3: 8px\n  )\n);\n\n@mixin typography($size, $type) {\n  font-family: Arial, sans-serif;\n  font-size: map-get(map-get($font-sizes, $size), $type);\n\n  @if ($type == h1 or $type == p1) {\n    font-weight: bold;\n  } @else {\n    font-weight: normal;\n  }\n}\n\n/* Example usages\n:global(.jasper-player--xlarge) {\n  .h1 { @include typography(xlarge, h1); }\n  .h2 { @include typography(xlarge, h2); }\n  .h3 { @include typography(xlarge, h3); }\n  .p1 { @include typography(xlarge, p1); }\n  .p2 { @include typography(xlarge, p2); }\n  .p3 { @include typography(xlarge, p3); }\n}\n\n:global(.jasper-player--large) {\n  .h1 { @include typography(large, h1); }\n  .h2 { @include typography(large, h2); }\n  .h3 { @include typography(large, h3); }\n  .p1 { @include typography(large, p1); }\n  .p2 { @include typography(large, p2); }\n  .p3 { @include typography(large, p3); }\n}\n\n:global(.jasper-player--mediu