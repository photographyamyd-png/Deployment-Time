;\n  height: 100%;\n  background-image: linear-gradient(\n    to bottom,\n    rgba(0, 0, 0, 0.5),\n    rgba(0, 0, 0, 0.5)\n  );\n}\n\n.modal {\n  display: flex;\n  position: relative;\n  flex-direction: column;\n  overflow-y: auto;\n  border: solid 1px #383838;\n  border-radius: 5px;\n  background-image: linear-gradient(\n    91deg,\n    rgba(0, 0, 0, 0.85) 1%,\n    rgba(0, 0, 0, 0.85) 99%\n  );\n}\n\n.settings-container {\n  width: 100%;\n}\n\n.settings-header-container {\n  display: flex;\n}\n\n.settings-title {\n  margin-top: 8px;\n  text-align: left;\n  text-transform: uppercase;\n  letter-spacing: 1.1px;\n  color: #fff;\n}\n\n.text-track-styling-icon {\n  width: 32px;\n  height: 32px;\n  margin-right: 8px;\n}\n\n.column {\n  position: relative;\n}\n\n.row {\n  display: flex;\n}\n\n.reset-to-default-button {\n  padding: 0;\n  margin: 0;\n  border: none; /* stylelint-disable-line */\n  background-color: transparent;\n  outline: none; /* stylelint-disable-line */\n  text-decoration: underline;\n  color: #bfbfbf;\n}\n\n.close-button {\n  position: absolute;\n  top: 0;\n  right: 0;\n  border: 0;\n  margin: 0;\n  background-color: transparent;\n  color: #00c1f3;\n  appearance: none;\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      :global(.icon-button-fill-hover-color) {\n        fill: currentColor !important;\n      }\n    }\n  }\n}\n\n.close-button-icon {\n  width: 44px;\n  height: 44px;\n}\n\n:global(.jasper-player--xlarge) {\n  .settings-container {\n    padding: 20px 45px 50px;\n  }\n\n  .settings-header-container {\n    margin-bottom: 25px;\n  }\n\n  .settings-title {\n    font-size: 16px;\n  }\n\n  .modal {\n    width: 792px;\n    height: 80%;\n    max-height: 700px;\n    border-radius: 5px;\n  }\n\n  .row {\n    justify-content: space-between;\n  }\n\n  .column {\n    width: 305px;\n  }\n\n  .delimiter {\n    height: 100%;\n    border: 1px solid grey;\n  }\n\n  .reset-to-default-button {\n    position: absolute;\n    right: 0;\n    bottom: 0;\n    font-size: 16px;\n  }\n}\n\n:global(.jasper-player--large) {\n  .settings-container {\n    padding: 20px 30px 50px;\n  }\n\n  .settings-header-container {\n    margin-bottom: 20px;\n  }\n\n  .settings-title {\n    font-size: 14px;\n  }\n\n  .modal {\n    width: 719px;\n    height: 90%;\n    max-height: 560px;\n    border-radius: 5px;\n  }\n\n  .row {\n    justify-content: space-between;\n  }\n\n  .column {\n    width: 295px;\n  }\n\n  .delimiter {\n    height: 100%;\n    border: 1px solid grey;\n  }\n\n  .reset-to-default-button {\n    position: absolute;\n    right: 0;\n    bottom: 0;\n    font-size: 14px;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .settings-container {\n    padding: 20px 30px 50px;\n  }\n\n  .settings-header-container {\n    margin-bottom: 20px;\n  }\n\n  .settings-title {\n    font-size: 14px;\n  }\n\n  .modal {\n    width: 719px;\n    height: 90%;\n    max-height: 560px;\n    border-radius: 5px;\n  }\n\n  .row {\n    justify-content: space-between;\n  }\n\n  .column {\n    width: 295px;\n  }\n\n  .delimiter {\n    height: 100%;\n    border: 1px solid grey;\n  }\n\n  .reset-to-default-button {\n    position: absolute;\n    right: 0;\n    bottom: 0;\n    font-size: 14px;\n  }\n}\n\n:global(.jasper-player--small) {\n  .settings-container {\n    padding: 20px 17% 0;\n  }\n\n  .settings-header-container {\n    margin-bottom: 15px;\n  }\n\n  .settings-title {\n    font-size: 12px;\n  }\n\n  .modal {\n    width: 100%;\n    height: 100%;\n    border-radius: 0;\n  }\n\n  .row {\n    flex-wrap: wrap;\n  }\n\n  .column {\n    width: 100%;\n  }\n\n  .delimiter {\n    display: none;\n  }\n\n  .reset-to-default-button {\n    margin-bottom: 125px;\n    font-size: 13px;\n  }\n}\n\n:global(.jasper-player--mini) {\n  .settings-container {\n    padding: 20px 17% 0;\n  }\n\n  .settings-header-container {\n    margin-bottom: 15px;\n  }\n\n  .settings-title {\n    font-size: 12px;\n  }\n\n  .modal {\n    width: 100%;\n    height: 100%;\n    border-radius: 0;\n  }\n\n  .row {\n    flex-wrap: wrap;\n  }\n\n  .column {\n    width: 100%;\n  }\n\n  .delimiter {\n    display: none;\n  }\n\n  .reset-to-default-button {\n    margin-bottom: 125px;\n    font-size: 13px;\n  }\n}\n","$ad-break-overlay-index: 2;\n$banner-ad-overlay-index: 3;\n$blackout-overlay-index: 5;\n$cast-overlay-index: 1;\n$debug-overlay-index: 16;\n$end-screen-overlay-index: 2;\n$error-overlay-index: 11;\n$loading-overlay-index: 10;\n$pause-ad-overlay-index: 2;\n$popover-dialog-overlay-index: 4;\n$preview-overlay-index: 10;\n$skip-breaks-overlay-index: 2;\n$text-track-styling-overlay-index: 5;\n$toast-overlay-index: 14;\n$tv-channel-switcher-index: 3;\n$tv-dynamic-button-index: 2;\n$tv-panel-overlay-index: 1;\n$up-next-overlay-index: 2;\n$up-next-overlay-small-index: 3;\n$performance-overlay-index: 15;\n\n$airplay-button-index: 3;\n$cast-button-index: 3;\n$center-controls-index: 4;\n$controls-index: 3;\n$loading-indicator-index: 10;\n$seek-bar-index: 1;\n$seek-bar-tooltip-index: 11;\n$tooltip-index: 3;\n$volume-slider-index: 2;\n$title-index: 3;\n\n$close-float-button-index: 3;\n$float-index: 9999;\n$overlay-focus-index: 9999;\n\n$bell-blue: #0066a4;\n\n$tv-horizontal-margins: 7.5%;\n"],sourceRoot:""}]);var s="jasper-player-text-track-styling-modal__container--f2FpG",u="jasper-player-text-track-styling-modal__modal--dUqu9",l="jasper-player-text-track-styling-modal__settings-container--tBrMk",c="jasper-player-text-track-styling-modal__settings-header-container--tFbKD",f="jasper-player-text-track-styling-modal__settings-title--U9KkN",h="jasper-player-text-track-styling-modal__text-track-styling-icon--iqjyM",d="jasper-player-text-track-styling-modal__column--umTsw",_="jasper-player-text-track-styling-modal__row--ve6mn",p="jasper-player-text-track-styling-modal__reset-to-default-button--R8vgh",v="jasper-player-text-track-styling-modal__close-button--hT0u0",A="jasper-player-text-track-styling-modal__close-button-ic