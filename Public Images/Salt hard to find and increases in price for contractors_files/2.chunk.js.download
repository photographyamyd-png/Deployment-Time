\n  background-color: transparent;\n  color: #00c1f3;\n  appearance: none;\n  pointer-events: auto;\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      :global(.icon-button-fill-hover-color) {\n        fill: currentColor !important;\n      }\n    }\n  }\n}\n\n.close-button-icon {\n  width: 32px;\n  height: 32px;\n  margin-left: 8px;\n}\n\n:global(.jasper-player--xlarge) {\n  .toast-container {\n    max-width: 680px;\n  }\n\n  .toast-container-bottom {\n    bottom: 160px;\n  }\n\n  .toast-container-top {\n    top: 60px;\n  }\n\n  .message {\n    font-size: 18px;\n  }\n\n  .close-button {\n    flex: 0 0 50px;\n  }\n\n  .close-button-icon {\n    width: 40px;\n    height: 40px;\n    margin-left: 10px;\n  }\n}\n\n:global(.jasper-player--small) {\n  .toast-container {\n    max-width: 250px;\n    padding: 5px;\n  }\n\n  .toast-container-bottom {\n    bottom: 60px;\n  }\n\n  .toast-container-top {\n    top: 20px;\n  }\n\n  .message {\n    font-size: 12px;\n  }\n\n  .close-button {\n    flex: 0 0 30px;\n  }\n\n  .close-button-icon {\n    width: 25px;\n    height: 25px;\n    margin-left: 5px;\n  }\n}\n\n:global(.jasper-player--mini) {\n  .toast-container {\n    max-width: 250px;\n    padding: 5px;\n  }\n\n  .toast-container-bottom {\n    bottom: 60px;\n  }\n\n  .toast-container-top {\n    top: 20px;\n  }\n\n  .message {\n    font-size: 12px;\n  }\n\n  .close-button {\n    flex: 0 0 30px;\n  }\n\n  .close-button-icon {\n    width: 25px;\n    height: 25px;\n    margin-left: 5px;\n  }\n}\n","$ad-break-overlay-index: 2;\n$banner-ad-overlay-index: 3;\n$blackout-overlay-index: 5;\n$cast-overlay-index: 1;\n$debug-overlay-index: 16;\n$end-screen-overlay-index: 2;\n$error-overlay-index: 11;\n$loading-overlay-index: 10;\n$pause-ad-overlay-index: 2;\n$popover-dialog-overlay-index: 4;\n$preview-overlay-index: 10;\n$skip-breaks-overlay-index: 2;\n$text-track-styling-overlay-index: 5;\n$toast-overlay-index: 14;\n$tv-channel-switc