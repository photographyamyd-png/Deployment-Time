\n  width: 100%;\n  height: 100%;\n  background-color: #000;\n  cursor: pointer;\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      :global(.icon-button-fill-hover-color) {\n        fill: currentColor !important;\n        transition: fill 400ms ease;\n      }\n    }\n  }\n}\n\n.background-image {\n  display: block;\n  width: 100%;\n  max-width: 100%;\n  height: 100%;\n  max-height: 100%;\n  margin: 0 auto;\n  object-fit: contain;\n}\n\n.center {\n  display: flex;\n  position: absolute;\n  justify-content: center;\n  align-items: center;\n  margin: auto;\n}\n\n.play-icon {\n  width: 96px;\n  height: 96px;\n  filter: drop-shadow(3px 3px 2px rgba(0, 0, 0, 0.7));\n}\n\n:global(.jasper-player--large) {\n  .play-icon {\n    width: 72px;\n    height: 72px;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .play-icon {\n    width: 72px;\n    height: 72px;\n  }\n}\n\n:global(.jasper-player--small) {\n  .play-icon {\n    width: 48px;\n    height: 48px;\n  }\n}\n\n:global(.jasper-player--mini) {\n  .play-icon {\n    width: 48px;\n    height: 48px;\n  }\n}\n","$ad-break-overlay-index: 2;\n$banner-ad-overlay-index: 3;\n$blackout-overlay-index: 5;\n$cast-overlay-index: 1;\n$debug-overlay-index: 16;\n$end-screen-overlay-index: 2;\n$error-overlay-index: 11;\n$loading-overlay-index: 10;\n$pause-ad-overlay-index: 2;\n$popover-dialog-overlay-index: 4;\n$preview-overlay-index: 10;\n$skip-breaks-overlay-index: 2;\n$text-track-styling-overlay-index: 5;\n$toast-overlay-index: 14;\n$tv-channel-switcher-index: 3;\n$tv-dynamic-button-index: 2;\n$tv-panel-overlay-index: 1;\n$up-next-overlay-index: 2;\n$up-next-overlay-small-index: 3;\n$performance-overlay-index: 15;\n\n$airplay-button-index: 3;\n$cast-button-index: 3;\n$center-controls-index: 4;\n$controls-index: 3;\n$loading-indicator-index: 10;\n$seek-bar-index: 1;\n$seek-bar-tooltip-index: 11;\n$tooltip-index: 3;\n$volume-slider-index: 2;\n$title-index: 3;\n\n$close-float-button-i