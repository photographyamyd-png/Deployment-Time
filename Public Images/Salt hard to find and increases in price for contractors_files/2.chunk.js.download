-50%);\n  padding: 0;\n  border: 0;\n  background: rgba(0, 0, 0, 0);\n  font-size: 40px;\n  color: #00c1f3;\n  transition: 100ms opacity ease;\n  appearance: none;\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      :global(.icon-button-fill-hover-color) {\n        transition: 400ms stroke ease;\n        stroke: currentColor !important;\n      }\n    }\n  }\n}\n\n.tile {\n  flex: 0 0 294px;\n}\n\n.button-visible {\n  display: block;\n  pointer-events: all;\n}\n\n.button-background-visible {\n  opacity: 1;\n}\n\n.button-background-previous {\n  left: -60px;\n  background-image: linear-gradient(\n    to left,\n    rgba(0, 0, 0, 0),\n    rgb(0, 0, 0, 1) 100%\n  );\n}\n\n.button-background-next {\n  right: -60px;\n  background-image: linear-gradient(\n    to right,\n    rgba(0, 0, 0, 0),\n    rgb(0, 0, 0, 1) 100%\n  );\n}\n\n.button-previous,\n.button-next {\n  width: 80px;\n  height: 100px;\n}\n\n.button-previous {\n  left: 42px;\n}\n\n.button-next {\n  right: 42px;\n}\n\n.arrow-left-icon,\n.arrow-right-icon {\n  display: block;\n  width: 57px;\n  height: 57px;\n}\n\n:global(.jasper-player--large) {\n  .button-background-previous,\n  .button-background-next {\n    width: 150px;\n    height: 114px;\n  }\n\n  .button-background-previous {\n    left: -40px;\n  }\n\n  .button-background-next {\n    right: -40px;\n  }\n\n  .button-previous,\n  .button-next {\n    width: 50px;\n    height: 75px;\n  }\n\n  .button-previous {\n    left: 30px;\n  }\n\n  .button-next {\n    right: 30px;\n  }\n\n  .arrow-left-icon,\n  .arrow-right-icon {\n    width: 40px;\n    height: 40px;\n  }\n\n  .tile {\n    flex: 0 0 200px;\n  }\n\n  .content {\n    gap: 30px;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .button-background-previous,\n  .button-background-next {\n    width: 150px;\n    height: 114px;\n  }\n\n  .button-background-previous {\n    left: -40px;\n  }\n\n  .button-background-next {\n    right: -40px;\n  }\n\n  .button