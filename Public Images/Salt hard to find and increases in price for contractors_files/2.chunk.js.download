e 200ms;\n  pointer-events: auto;\n\n  &:focus {\n    border: 1px solid #fff;\n    box-shadow: 0 0 0 3px white;\n  }\n\n  &:hover {\n    border: 1px solid #fff;\n    box-shadow: 0 0 0 3px white;\n  }\n}\n\n:global(.jasper-player--xlarge) {\n  .minimized-player-container-shrunk {\n    top: 45px;\n    right: 45px;\n    left: auto;\n    width: 416px;\n    height: 234px;\n  }\n\n  .back-to-video {\n    width: 135px;\n    height: 35px;\n    font-size: 15px;\n  }\n}\n\n:global(.jasper-player--large) {\n  .minimized-player-container-shrunk {\n    top: 40px;\n    right: 40px;\n    left: auto;\n    width: 336px;\n    height: 189px;\n  }\n\n  .back-to-video {\n    width: 115px;\n    height: 32px;\n    font-size: 13px;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .minimized-player-container-shrunk {\n    top: 25px;\n    right: 25px;\n    left: auto;\n    width: 256px;\n    height: 144px;\n  }\n\n  .minimized-player-container-border {\n    &:focus {\n      border: 1px solid #fff;\n      box-shadow: 0 0 0 2px white;\n    }\n\n    &:hover {\n      border: 1px solid #fff;\n      box-shadow: 0 0 0 2px white;\n    }\n  }\n\n  .back-to-video {\n    width: 105px;\n    height: 28px;\n    font-size: 12px;\n  }\n}\n\n:global(.jasper-player--small) {\n  .minimized-player-container-shrunk {\n    top: 15px;\n    right: 15px;\n    left: auto;\n    width: 192px;\n    height: 108px;\n  }\n\n  .minimized-player-container-border {\n    &:focus {\n      border: 1px solid #fff;\n      box-shadow: 0 0 0 2px white;\n    }\n\n    &:hover {\n      border: 1px solid #fff;\n      box-shadow: 0 0 0 2px white;\n    }\n  }\n\n  .back-to-video {\n    width: 85px;\n    height: 25px;\n    font-size: 10px;\n  }\n}\n"],sourceRoot:""}]);var s="jasper-player-watch-next-minimized-player__minimized-player--XOzSy",u="jasper-player-watch-next-minimized-player__minimized-player-container-expanded--QPmJx",l="jasper-player-watch-next-minimized-player__back-to-video--piLeQ",c="jasper-player-watch-next-minimized-player