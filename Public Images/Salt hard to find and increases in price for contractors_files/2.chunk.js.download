 border-radius: 50%;\n    background-color: #fff;\n    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.16);\n    cursor: pointer;\n  }\n}\n\n:global(.jasper-player--xlarge) {\n  .slider-wrapper {\n    top: -130px;\n    width: 45px;\n    height: 130px;\n  }\n\n  .slider-container {\n    height: 120px;\n  }\n\n  .slider {\n    width: 5px;\n    height: 90px;\n  }\n\n  .sliderValue {\n    &::after {\n      width: 18px;\n      height: 18px;\n    }\n  }\n}\n\n:global(.jasper-player--large) {\n  .slider-wrapper {\n    top: -130px;\n    width: 45px;\n    height: 130px;\n  }\n\n  .slider-container {\n    height: 120px;\n  }\n\n  .slider {\n    width: 5px;\n    height: 90px;\n  }\n\n  .sliderValue {\n    &::after {\n      width: 18px;\n      height: 18px;\n    }\n  }\n}\n\n:global(.jasper-player--medium) {\n  .slider-wrapper {\n    top: -130px;\n    width: 45px;\n    height: 130px;\n  }\n\n  .slider-container {\n    height: 120px;\n  }\n\n  .slider {\n    width: 5px;\n    height: 90px;\n  }\n\n  .sliderValue {\n    &::after {\n      width: 18px;\n      height: 18px;\n    }\n  }\n}\n\n:global(.jasper-player--small) {\n  .slider-wrapper {\n    top: -80px;\n    width: 28px;\n    height: 80px;\n  }\n\n  .slider-container {\n    height: 72px;\n  }\n\n  .slider {\n    width: 4px;\n    height: 55px;\n  }\n\n  .sliderValue {\n    &::after {\n      width: 11px;\n      height: 11px;\n    }\n  }\n}\n\n:global(.jasper-player--mini) {\n  .slider-wrapper {\n    top: -80px;\n    width: 28px;\n    height: 80px;\n  }\n\n  .slider-container {\n    height: 72px;\n  }\n\n  .slider {\n    width: 4px;\n    height: 55px;\n  }\n\n  .sliderValue {\n    &::after {\n      width: 11px;\n      height: 11px;\n    }\n  }\n}\n","$ad-break-overlay-index: 2;\n$banner-ad-overlay-index: 3;\n$blackout-overlay-index: 5;\n$cast-overlay-index: 1;\n$debug-overlay-index: 16;\n$end-screen-overlay-index: 2;\n$error-overlay-index: 11;\n$loading-overlay-index: 10;\n$pause-ad-overlay-index: 2;\n$popover-dialog-overlay-index: 4;\n$p