olumn;\n  width: 100%;\n  height: 100%;\n  border-radius: 0 5px 5px 0;\n  font-size: 21px;\n  font-weight: 700;\n}\n\n.info {\n  margin-left: 16px;\n}\n\n.progress-bar {\n  display: none;\n  top: 0;\n  height: 4px;\n  background: #0031ff;\n  transition: width 1s linear;\n\n  &.visible {\n    display: block;\n  }\n}\n\n.playing-in-label {\n  margin-top: 12px;\n}\n\n.content-information {\n  margin-top: 24px;\n}\n\n.subtitle {\n  margin-top: 6px;\n  font-size: 16px;\n  font-weight: 400;\n}\n\n.reject-button {\n  display: none;\n  position: relative;\n  justify-content: center;\n  align-items: center;\n  width: 56px;\n  height: 56px;\n  border: 1px solid #2f2f2f;\n  border-radius: 50%;\n  margin-left: 24px;\n  background: rgba(18, 18, 18, 0.75);\n  background-clip: padding-box;\n  color: #fff;\n\n  &.visible {\n    display: flex;\n  }\n\n  &:focus {\n    border: 0;\n    background-color: rgba(255, 255, 255, 0.95);\n    color: black;\n\n    &::before {\n      content: '';\n      position: absolute;\n      top: -8px;\n      right: 0;\n      bottom: 0;\n      left: -8px;\n      width: 72px;\n      height: 72px;\n      border: 8px solid rgba(255, 255, 255, 0.5);\n      border-radius: 50%;\n      background-color: transparent;\n    }\n  }\n\n  /* Device that can hover (Magic Remote from LG TVs) */\n  @media (hover: hover) {\n    &:hover:not(:focus) {\n      &::before {\n        content: '';\n        position: absolute;\n        top: -8px;\n        right: 0;\n        bottom: 0;\n        left: -8px;\n        width: 72px;\n        height: 72px;\n        border: 8px solid rgba(255, 255, 255, 0.5);\n        border-radius: 50%;\n        background-color: transparent;\n      }\n    }\n  }\n}\n\n.reject-button-icon {\n  width: 44px;\n  height: 44px;\n\n  :global(.icon-button-fill-hover-color) {\n    fill: currentColor !important;\n    transition: fill 400ms ease;\n  }\n}\n","$ad-break-overlay-index: 2;\n$banner-ad-overlay-index: 3;\n$blackout-overlay-index: 5;\n$cast-overlay-index: