tems: center;\n  font-weight: 400;\n  color: #aeaeae;\n}\n\n.content-name {\n  font-weight: 700;\n  line-height: normal;\n}\n\n.description {\n  display: -webkit-box; /* stylelint-disable-line */\n  overflow: hidden;\n  text-overflow: ellipsis;\n  font-weight: 400;\n  -webkit-box-orient: vertical; /* stylelint-disable-line */\n  -webkit-line-clamp: 3;\n}\n\n.genres {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-weight: 400;\n}\n\n.cast-container {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.cast-title {\n  font-weight: 400;\n  color: #aeaeae;\n}\n\n.cast {\n  font-weight: 400;\n}\n\n.play-button-container {\n  display: flex;\n  justify-content: flex-start;\n}\n\n:global(.jasper-player--xlarge) {\n  .next-content-container {\n    top: 20%;\n    left: 50px;\n    width: 520px;\n  }\n\n  .content-name {\n    margin-bottom: 5px;\n    font-size: 35px;\n  }\n\n  .playback-information-container {\n    margin-bottom: 5px;\n    font-size: 15px;\n    font-weight: 400;\n  }\n\n  .playback-information-container > *:not(:last-child) {\n    margin-right: 9px;\n  }\n\n  .description {\n    font-size: 17px;\n    line-height: 25px;\n  }\n\n  .genres {\n    margin-top: 30px;\n    margin-bottom: 5px;\n    font-size: 17px;\n  }\n\n  .cast-title,\n  .cast {\n    font-size: 17px;\n  }\n\n  .play-button-container {\n    margin-top: 23px;\n    margin-left: -10px;\n  }\n\n  .play-button {\n    width: 75px !important;\n    height: 75px !important;\n  }\n\n  .play-icon {\n    width: 33px;\n    height: 32px;\n  }\n\n  .described-video-icon {\n    width: 33px;\n    height: 33px;\n\n    :global(.icon-button-fill-hover-color) {\n      fill: #aeaeae !important;\n    }\n  }\n}\n\n:global(.jasper-player--large) {\n  .next-content-container {\n    top: 23%;\n    left: 30px;\n    width: 418px;\n  }\n\n  .content-name {\n    margin-bottom: 5px;\n    font-size: 28px;\n  }\n\n  .playback-information-container {\n    margin-bottom: 5px;\n    font-size: 14px;\n  }\n\n  .playback-information-container > *:not(:last-child) {\n    margin-right: 7px;\n  }\n\n  .description {\n    font-size: 16px;\n    line-height: 24px;\n  }\n\n  .genres {\n    margin-top: 25px;\n    margin-bottom: 4px;\n    font-size: 16px;\n  }\n\n  .cast-title,\n  .cast {\n    font-size: 16px;\n  }\n\n  .play-button-container {\n    margin-top: 20px;\n    margin-left: -10px;\n  }\n\n  .play-button {\n    width: 65px !important;\n    height: 65px !important;\n  }\n\n  .play-icon {\n    width: 31px;\n    height: 30px;\n  }\n\n  .described-video-icon {\n    width: 30px;\n    height: 30px;\n\n    :global(.icon-button-fill-hover-color) {\n      fill: #aeaeae !important;\n    }\n  }\n}\n\n:global(.jasper-player--medium),\n:global(.jasper-player--small) {\n  .next-content-container {\n    top: 25%;\n    left: 20px;\n    width: 285px;\n  }\n\n  .content-name {\n    margin-bottom: 8px;\n    font-size: 21px;\n  }\n\n  .playback-information-container {\n    display: none;\n  }\n\n  .description {\n    font-size: 14px;\n    line-height: 22px;\n  }\n\n  .genres,\n  .cast-container {\n    display: none;\n  }\n\n  .play-button-container {\n    margin-top: 20px;\n    margin-left: -10px;\n  }\n\n  .play-button {\n    width: 60px !important;\n    height: 60px !important;\n  }\n\n  .play-icon {\n    width: 29px;\n    height: 28px;\n  }\n}\n"],sourceRoot:""}]);var s="jasper-player-watch-next-overlay-mobile__container--CSp61",u="jasper-player-watch-next-overlay-mobile__minimized-player-container--Nm3Gr",l="jasper-player-watch-next-overlay-mobile__background-image--b3LL_",c="jasper-player-watch-next-overlay-mobile__gradient--cVwJe",f="jasper-player-watch-next-overlay-mobile__next-content-container--RNNnL",h="jasper-player-watch-next-overlay-mobile__playback-information-container--_edZe",d="jasper-player-watch-next-overlay-mobile__content-name--kQOq4",_="jasper-player-watch-next-overlay-mobile__description--Xc4xA",p="jasper-player-watch-next-overlay-mobi