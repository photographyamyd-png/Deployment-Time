 transition: opacity 100ms ease;\n  pointer-events: none;\n\n  &::before {\n    content: '';\n    position: absolute;\n    width: 0;\n    height: 0;\n    border-top: 10px solid #383838;\n    border-right: 10px solid transparent;\n    border-left: 10px solid transparent;\n  }\n\n  &::after {\n    content: '';\n    position: absolute;\n    width: 0;\n    height: 0;\n    border-top: 10px solid #000;\n    border-right: 10px solid transparent;\n    border-left: 10px solid transparent;\n  }\n\n  &.position-top {\n    top: 0;\n    left: 50%;\n    transform: translate(-50%, calc(-100% - 13px));\n\n    &::before {\n      bottom: -11px;\n      left: 50%;\n      transform: translateX(-11px);\n    }\n\n    &::after {\n      bottom: -10px;\n      left: 50%;\n      transform: translateX(-11px);\n    }\n  }\n\n  &.position-bottom {\n    bottom: 0;\n    left: 50%;\n    transform: translate(-50%, calc(100% + 13px));\n\n    &::before {\n      top: -11px;\n      left: 50%;\n      transform: translateX(-11px) rotate(180deg);\n    }\n\n    &::after {\n      top: -10px;\n      left: 50%;\n      transform: translateX(-11px) rotate(180deg);\n    }\n  }\n\n  &.position-left {\n    top: 50%;\n    transform: translate(calc(-100% - 13px), -50%);\n\n    &::before {\n      right: -16px;\n      bottom: 50%;\n      transform: translateY(5px) rotate(-90deg);\n    }\n\n    &::after {\n      right: -15px;\n      bottom: 50%;\n      transform: translateY(5px) rotate(-90deg);\n    }\n  }\n\n  &.position-right {\n    top: 50%;\n    right: 0;\n    transform: translate(calc(100% + 13px), -50%);\n\n    &::before {\n      bottom: 50%;\n      left: -16px;\n      transform: translateY(5px) rotate(90deg);\n    }\n\n    &::after {\n      bottom: 50%;\n      left: -15px;\n      transform: translateY(5px) rotate(90deg);\n    }\n  }\n}\n\n@media (hover: hover) and (pointer: fine) {\n  .container {\n    &.visible {\n      display: block;\n    }\n  }\n}\n\n:global(.jasper-player--xlarge) {\n  .container {\n    padding: 14px 16px;\n    font-size: 18px;\n    line-height: 1.17;\n\n    &.adjust-right-edge {\n      left: 0;\n\n      &::before {\n        left: 65%;\n      }\n\n      &::after {\n        left: 65%;\n      }\n    }\n\n    &.adjust-left-edge {\n      left: 90%;\n\n      &::before {\n        left: 37%;\n      }\n\n      &::after {\n        left: 37%;\n      }\n    }\n  }\n}\n\n:global(.jasper-player--large) {\n  .container {\n    padding: 14px 16px;\n    font-size: 16px;\n    line-height: 1.13;\n\n    &.adjust-right-edge {\n      left: 0;\n\n      &::before {\n        left: 65%;\n      }\n\n      &::after {\n        left: 65%;\n      }\n    }\n\n    &.adjust-left-edge {\n      left: 100%;\n\n      &::before {\n        left: 35%;\n      }\n\n      &::after {\n        left: 35%;\n      }\n    }\n  }\n}\n\n:global(.jasper-player--medium) {\n  .container {\n    padding: 14px 16px;\n    font-size: 16px;\n    line-height: 1.13;\n\n    &.adjust-right-edge {\n      left: 0;\n\n      &::before {\n        left: 65%;\n      }\n\n      &::after {\n        left: 65%;\n      }\n    }\n\n    &.adjust-left-edge {\n      left: 100%;\n\n      &::before {\n        left: 35%;\n      }\n\n      &::after {\n        left: 35%;\n      }\n    }\n  }\n}\n\n:global(.jasper-player--small) {\n  .container {\n    padding: 8px 9px;\n    font-size: 11px;\n    line-height: 1.09;\n\n    &.adjust-right-edge {\n      left: -10%;\n\n      &::before {\n        left: 70%;\n      }\n\n      &::after {\n        left: 70%;\n      }\n    }\n\n    &.adjust-left-edge {\n      left: 120%;\n\n      &::before {\n        left: 28%;\n      }\n\n      &::after {\n        left: 28%;\n      }\n    }\n  }\n}\n\n:global(.jasper-player--mini) {\n  .container {\n    padding: 8px 9px;\n    font-size: 11px;\n    line-height: 1.09;\n\n    &.adjust-right-edge {\n      left: -10%;\n\n      &::before {\n        left: 70%;\n      }\n\n      &::after {\n        left: 70%;\n      }\n    }\n\n    &.adjust-left-edge {\n      left: 120%;\