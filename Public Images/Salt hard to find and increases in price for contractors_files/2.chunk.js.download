se 150ms;\n  cursor: pointer;\n  pointer-events: all;\n\n  &::before {\n    content: '';\n    position: absolute;\n    z-index: $ad-break-overlay-index;\n    bottom: 0;\n    left: 0;\n    opacity: 0.8;\n    width: 100%;\n    height: 50%;\n    background-image: linear-gradient(to bottom, rgba(0, 0, 0, 0), #000);\n  }\n\n  &.hidden {\n    opacity: 0;\n    pointer-events: none;\n  }\n}\n\n.container-controls {\n  position: absolute;\n  z-index: $controls-index;\n  bottom: 0;\n  left: 0;\n  justify-content: space-between;\n  align-items: center;\n  width: 100%;\n  transition: transform 300ms ease;\n}\n\n.casting {\n  cursor: default;\n}\n\n.top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.top-left {\n  display: flex;\n  align-items: center;\n}\n\n.bottom {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-weight: bold;\n  cursor: default;\n}\n\n.bottom-left {\n  display: flex;\n  align-items: center;\n}\n\n.bottom-right {\n  display: flex;\n  justify-content: flex-end;\n  align-items: center;\n}\n\n:global(.jasper-player--xlarge) {\n  .container-controls {\n    padding: 0 52px 40px; // If padding is changed, make sure to change the negative margins in .bottom\n\n    &.standard {\n      transform: translateY(170px);\n      transition: transform 300ms ease;\n    }\n  }\n\n  .top {\n    padding-top: 7px;\n    padding-bottom: 30px;\n    font-size: 22px;\n    line-height: 1.18;\n\n    &.compact {\n      padding-bottom: 0;\n    }\n  }\n\n  .top-left {\n    .control {\n      margin: 0 15px 0 0;\n    }\n  }\n\n  .bottom {\n    padding: 42px 52px 40px;\n    margin: 0 -52px -40px;\n  }\n\n  .bottom-left {\n    .control {\n      margin: 0 40px 0 0;\n    }\n  }\n\n  .bottom-right {\n    .control {\n      margin: 0 0 0 40px;\n    }\n  }\n\n  .icon {\n    width: 44px;\n    height: 44px;\n  }\n\n  .volume-icon {\n    width: 69px;\n    height: 69px;\n  }\n}\n\n:global(.jasper-player--large) {\n  .container-cont