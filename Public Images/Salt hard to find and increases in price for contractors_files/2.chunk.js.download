AAA,CACA,gBAAA,CAIJ,kDACE,6BAAA",sourcesContent:[".container {\n  display: flex;\n  flex-direction: column;\n  overflow-y: hidden;\n}\n\n.tab-title-container {\n  display: flex;\n  flex-direction: row;\n}\n\n.tab-title {\n  text-transform: uppercase;\n  color: #fff;\n}\n\n.section-picker-container {\n  display: flex;\n  justify-content: center;\n  overflow-y: hidden;\n}\n\n.section-picker {\n  overflow-x: hidden;\n  overflow-y: auto;\n}\n\n.section-picker-title {\n  width: fit-content;\n  text-transform: uppercase;\n  white-space: nowrap;\n  color: #858585;\n}\n\n.tab-content-list {\n  width: 100%;\n  margin: 0;\n  list-style: none;\n  text-align: left;\n  font-weight: bold;\n  color: #858585;\n}\n\n.styling-button-container {\n  display: flex;\n  flex-direction: row;\n  justify-content: flex-end;\n}\n\n.styling-button {\n  display: flex;\n  padding: 0;\n  border: none; /* stylelint-disable-line */\n  margin: 0;\n  background-color: transparent;\n  text-decoration: underline;\n  outline: none; /* stylelint-disable-line */\n  color: #fff;\n}\n\n:global(.jasper-player--xlarge) {\n  .tab-container {\n    padding: 30px 30px 45px;\n  }\n\n  .tab-title {\n    font-size: 21px;\n    line-height: 2.7;\n    letter-spacing: 1.8px;\n  }\n\n  .section-picker-container {\n    padding-bottom: 50px;\n  }\n\n  .section-picker {\n    padding: 0 55px 40px 63px;\n    font-size: 11px;\n    letter-spacing: 1.1px;\n  }\n\n  .section-picker-title {\n    font-size: 16px;\n    letter-spacing: 1.6px;\n  }\n\n  .tab-content-list {\n    padding: 30px 0 0;\n    font-size: 18px;\n    line-height: 1.17;\n  }\n\n  .language-icon {\n    width: 55px;\n    height: 55px;\n    margin-right: 15px;\n  }\n\n  .styling-button-container {\n    padding: 0 30px 30px;\n    font-size: 18px;\n  }\n\n  .text-track-styling-icon {\n    width: 30px;\n    height: 30px;\n    margin-right: 8px;\n  }\n}\n\n:global(.jasper-player--large) {\n  .tab-container {\n    padding: 20px 20px 34px;\n  }\n\n  .tab-title {\n    font-size: 14px;\n    line-height: 2.8;\n    letter-spacing: 1.2px;\n  }\n\n  .section-picker-container {\n    padding-bottom: 25px;\n  }\n\n  .section-picker {\n    padding: 0 40px 35px;\n    font-size: 11px;\n    letter-spacing: 1.1px;\n  }\n\n  .tab-content-list {\n    padding: 21px 0 0;\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .language-icon {\n    width: 38px;\n    height: 38px;\n    margin-right: 10px;\n  }\n\n  .styling-button-container {\n    padding: 0 17px 17px;\n    font-size: 16px;\n  }\n\n  .text-track-styling-icon {\n    width: 22px;\n    height: 22px;\n    margin-right: 6px;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .tab-container {\n    padding: 20px 20px 34px;\n  }\n\n  .tab-title {\n    font-size: 14px;\n    line-height: 2.8;\n    letter-spacing: 1.2px;\n  }\n\n  .section-picker-container {\n    padding-bottom: 25px;\n  }\n\n  .section-picker {\n    padding: 0 40px 35px;\n    font-size: 11px;\n    letter-spacing: 1.1px;\n  }\n\n  .tab-content-list {\n    padding: 21px 0 0;\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .language-icon {\n    width: 38px;\n    height: 38px;\n    margin-right: 10px;\n  }\n\n  .styling-button-container {\n    padding: 0 17px 17px;\n    font-size: 16px;\n  }\n\n  .text-track-styling-icon {\n    width: 22px;\n    height: 22px;\n    margin-right: 6px;\n  }\n}\n\n:global(.jasper-player--small) {\n  .tab-container {\n    padding: 12px 12px 10px;\n  }\n\n  .tab-title {\n    font-size: 11px;\n    line-height: 2.5;\n    letter-spacing: 1.1px;\n  }\n\n  .section-picker {\n    scrollbar-width: thin;\n\n    &::-webkit-scrollbar {\n      width: 5px;\n    }\n\n    &::-webkit-scrollbar-track {\n      background: #f1f1f1;\n    }\n\n    &::-webkit-scrollbar-thumb {\n      background: #888;\n    }\n\n    &::-webkit-scrollbar-thumb:hover {\n      background: #555;\n    }\n  }\n\n  .section-picker-container {\n    padding-bottom: 12px;\n  }\n\n  .section-picker {\n    padding: 0 25px;\n    font-size: 8px;\n    letter-spacing: 0.8px;\n  }\n\n  .tab-content-list {\n    padding: 11px 0 0;\n    font-size: 11px;\n    line-height: 1.09;\n  }\n\n  .language-icon {\n    width: 27px;\n    height: 27px;\n    margin-right: 5px;\n  }\n\n  .styling-button-container {\n    padding: 0 10px 5px 0;\n    font-size: 11px;\n  }\n\n  .styling-button {\n    line-height: 2.2;\n  }\n\n  .text-track-styling-icon {\n    width: 22px;\n    height: 22px;\n    margin-right: 4px;\n  }\n}\n\n:global(.jasper-player--mini) {\n  .tab-container {\n    padding: 12px 12px 10px;\n  }\n\n  .tab-title {\n    font-size: 11px;\n    line-height: 2.5;\n    letter-spacing: 1.1px;\n  }\n\n  .section-picker {\n    scrollbar-width: thin;\n\n    &::-webkit-scrollbar {\n      width: 5px;\n    }\n\n    &::-webkit-scrollbar-track {\n      background: #f1f1f1;\n    }\n\n    &::-webkit-scrollbar-thumb {\n      background: #888;\n    }\n\n    &::-webkit-scrollbar-thumb:hover {\n      background: #555;\n    }\n  }\n\n  .section-picker-container {\n    padding-bottom: 12px;\n  }\n\n  .section-picker {\n    padding: 0 25px;\n    font-size: 8px;\n    letter-spacing: 0.8px;\n  }\n\n  .tab-content-list {\n    padding: 11px 0 0;\n    font-size: 11px;\n    line-height: 1.09;\n  }\n\n  .language-icon {\n    width: 27px;\n    height: 27px;\n    margin-right: 5px;\n  }\n\n  .styling-button-container {\n    padding: 0 10px 5px 0;\n    font-size: 11px;\n  }\n\n  .styling-button {\n    line-height: 2.2;\n  }\n\n  .text-track-styling-icon {\n    width: 22px;\n    height: 22px;\n    margin-right: 4px;\n  }\n}\n\n.delimiter {\n  border-left: 1px solid #858585;\n}\n"],sourceRoot:""}]);var s="jasper-player-language-overlay__container--J7REX",u="jasper-player-language-overlay__tab-title-container--gxowa",l="jasper-player-language-overlay__tab-title--i0xrn",c="jasper-player-language-overlay__section-picker-container--OcpGA",f="jasper-player-language-overlay__section-picker--FlMAA",h="jasper-player-language-overlay__section-picker-title--fmq2o",d="ja