direction: column;\n  justify-content: center;\n  align-items: center;\n  width: 500px;\n  border-radius: 12px;\n  background-color: rgba(18, 18, 18, 0.75);\n  pointer-events: none;\n}\n\n.titles-section {\n  display: block;\n  position: relative;\n  width: 100%;\n  padding: 6px 45px;\n  border: 8px solid transparent;\n  border-radius: 12px;\n  background-clip: padding-box;\n  background-color: transparent;\n  text-align: center;\n  color: white;\n}\n\n.thumbnail-section {\n  width: 100%;\n}\n\n.info-section {\n  padding: 28px;\n}\n\n.main-title {\n  @include typography-tv(h2);\n}\n\n.live-channel-title {\n  margin-bottom: 20px;\n  font-size: 28px;\n  font-weight: bold;\n}\n\n.live-channel-logo {\n  height: 55px;\n}\n\n.sub-title {\n  font-size: 21px;\n}\n\n.thumbnail-image {\n  width: 100%;\n  height: 300px;\n  border-radius: 12px;\n  object-fit: cover;\n  object-position: center;\n}\n\n.text-content-row {\n  margin: 0 0 15px;\n  font-size: 21px;\n  color: white;\n}\n\n.text-content-row:last-child {\n  margin: 0;\n}\n\n.inline-text-container {\n  display: inline-block;\n  margin: 0 20px 0 0;\n}\n\n.greyed-out-text {\n  color: #aeaeae;\n}\n\n.content-description {\n  font-size: 18px;\n}\n","$ad-break-overlay-index: 2;\n$banner-ad-overlay-index: 3;\n$blackout-overlay-index: 5;\n$cast-overlay-index: 1;\n$debug-overlay-index: 16;\n$end-screen-overlay-index: 2;\n$error-overlay-index: 11;\n$loading-overlay-index: 10;\n$pause-ad-overlay-index: 2;\n$popover-dialog-overlay-index: 4;\n$preview-overlay-index: 10;\n$skip-breaks-overlay-index: 2;\n$text-track-styling-overlay-index: 5;\n$toast-overlay-index: 14;\n$tv-channel-switcher-index: 3;\n$tv-dynamic-button-index: 2;\n$tv-panel-overlay-index: 1;\n$up-next-overlay-index: 2;\n$up-next-overlay-small-index: 3;\n$performance-overlay-index: 15;\n\n$airplay-button-index: 3;\n$cast-button-index: 3;\n$center-controls-index: 4;\n$controls-index: 3;\n$loading-indicator-index: 10;\n$seek-bar-index: 1;\n$seek-bar-tooltip-index: 11;\n$t