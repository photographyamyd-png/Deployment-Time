ss"],names:[],mappings:"AAAA,gDACE,YAAA,CACA,iBAAA,CACA,sBAAA,CACA,kBAAA,CACA,iBAAA,CACA,8BAAA,CAGF,6CACE,YAAA,CACA,iBAAA,CACA,sBAAA,CACA,kBAAA,CACA,UAAA,CACA,WAAA,CACA,YAAA,CACA,8BAAA,CACA,iBAAA,CACA,2BAAA,CACA,mCAAA,CACA,UAAA,CACA,qBAAA,CAEA,qDACE,UAAA,CACA,iBAAA,CACA,KAAA,CACA,OAAA,CACA,QAAA,CACA,MAAA,CACA,SAAA,CACA,wBAAA,CACA,iBAAA,CACA,8BAAA,CACA,qBAAA,CAGF,wFACE,iBAAA,CACA,cAAA,CACA,eAAA,CACA,gBAAA,CACA,UAAA,CAIF,qBACE,mDACE,mCAAA,CAAA,CAIJ,mDACE,mCAAA,CACA,qBAAA,CAEA,8FACE,UAAA,CAGF,iFACE,4BAAA,CAEF,mFACE,8BAAA,CAGF,2DACE,SAAA,CAKN,sDACE,YAAA,CACA,iBAAA,CACA,sBAAA,CACA,kBAAA,CACA,UAAA,CACA,WAAA,CACA,YAAA,CACA,8BAAA,CACA,iBAAA,CACA,2BAAA,CACA,mCAAA,CACA,UAAA,CACA,qBAAA,CAEA,oFACE,4BAAA,CAEF,sFACE,8BAAA,CAGF,8DACE,UAAA,CACA,iBAAA,CACA,KAAA,CACA,OAAA,CACA,QAAA,CACA,MAAA,CACA,SAAA,CACA,iBAAA,CACA,wBAAA,CACA,qBAAA,CAGF,iGACE,iBAAA,CACA,cAAA,CACA,eAAA,CACA,gBAAA,CACA,UAAA,CAIF,qBACE,4DACE,mCAAA,CAAA,CAIJ,4DACE,mCAAA,CACA,wBAAA,CAEA,uGACE,UAAA,CAKN,wDACE,iBAAA,CACA,KAAA,CACA,MAAA,CACA,UAAA,CACA,WAAA,CAGF,qDACE,SAAA",sourcesContent:[".container {\n  display: flex;\n  position: relative;\n  justify-content: center;\n  align-items: center;\n  border-radius: 50%;\n  background-color: transparent;\n}\n\n.button {\n  display: flex;\n  position: relative;\n  justify-content: center;\n  align-items: center;\n  width: 80px;\n  height: 80px;\n  padding: 13px;\n  border: 8px solid transparent;\n  border-radius: 50%;\n  background-clip: padding-box;\n  background-color: rgba(18, 18, 18, 0.75);\n  color: #000;\n  transition: ease 200ms;\n\n  &::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    opacity: 1;\n    border: 2px solid #2f2f2f;\n    border-radius: 50%;\n    background-color: transparent;\n    transition: ease 200ms;\n  }\n\n  .text {\n    padding-left: 14px;\n    font-size: 21px;\n    font-weight: 700;\n    line-height: 28px;\n    color: #fff;\n  }\n\n  /* Device that can hover (Magic Remote from LG TVs) */\n  @media (hover: hover) {\n    &:hover {\n      border: 8px solid rgba(255, 255, 255, 0.2);\n    }\n  }\n\n  &:focus {\n    border: 8px solid rgba(255, 255, 255, 0.5);\n    background-color: #fff;\n\n    .text {\n      color: #000;\n    }\n\n    :global(.icon-button-fill-hover-color) {\n      fill: currentColor !important;\n    }\n    :global(.icon-button-stroke-hover-color) {\n      stroke: currentColor !important;\n    }\n\n    &::before {\n      opacity: 0;\n    }\n  }\n}\n\n.progress-button {\n  display: flex;\n  position: relative;\n  justify-content: center;\n  align-items: center;\n  width: 80px;\n  height: 80px;\n  padding: 13px;\n  border: 8px solid transparent;\n  border-radius: 50%;\n  background-clip: padding-box;\n  background-color: rgba(18, 18, 18, 0.75);\n  color: #000;\n  transition: ease 200ms;\n\n  :global(.icon-button-fill-hover-color) {\n    fill: currentColor !important;\n  }\n  :global(.icon-button-stroke-hover-color) {\n    stroke: currentColor !important;\n  }\n\n  &::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    opacity: 1;\n    border-radius: 50%;\n    background-color: #5d5d5d;\n    transition: ease 200ms;\n  }\n\n  .text {\n    padding-left: 14px;\n    font-size: 21px;\n    font-weight: 700;\n    line-height: 28px;\n    color: #000;\n  }\n\n  /* Device that can hover (Magic Remote from LG TVs) */\n  @media (hover: hover) {\n    &:hover {\n      border: 8px solid rgba(255, 255, 255, 0.2);\n    }\n  }\n\n  &:focus {\n    border: 8px solid rgba(255, 255, 255, 0.5);\n    background-color: #5d5d5d;\n\n    .text {\n      color: #000;\n    }\n  }\n}\n\n.circular-progress {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.icon-container {\n  z-index: 1;\n}\n"],sourceRoot:""}]);var s="jasper-player-icon-button-tv__container--x_M9X",u="jasper-player-icon-button-tv__button--Xc1En",l="jasper-player-icon-button-tv__text--rsvO4",c="jasper-playe