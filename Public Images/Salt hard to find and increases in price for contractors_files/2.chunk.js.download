F,6DACE,UAAA,CAGF,gEACE,UAAA,CAGF,oEACE,UAAA,CAGF,oEACE,WAAA,CACA,YAAA,CAGF,wEACE,iBAAA,CACA,cAAA,CACA,gBAAA,CAGF,yEACE,SAAA,CAEA,sHACE,YAAA,CAOF,yEACE,UAAA,CAIJ,gEACE,UAAA,CAGF,8DACE,UAAA,CAGF,iEACE,UAAA,CAGF,qEACE,UAAA,CAGF,qEACE,WAAA,CACA,YAAA,CAGF,yEACE,iBAAA,CACA,cAAA,CACA,gBAAA,CAGF,0EACE,SAAA,CAEA,uHACE,YAAA,CAOF,wEACE,UAAA,CAIJ,oEACE,WAAA,CACA,YAAA,CAGF,wEACE,eAAA,CACA,cAAA,CACA,gBAAA,CAGF,yEACE,SAAA,CAEA,sHACE,YAAA,CAIJ,+DACE,UAAA,CAGF,6DACE,UAAA,CAGF,gEACE,UAAA,CAGF,oEACE,UAAA,CAMA,uEACE,UAAA,CAIJ,mEACE,WAAA,CACA,YAAA,CAGF,uEACE,eAAA,CACA,cAAA,CACA,gBAAA,CAGF,wEACE,SAAA,CAEA,qHACE,YAAA,CAIJ,8DACE,UAAA,CAGF,4DACE,UAAA,CAGF,+DACE,UAAA,CAGF,mEACE,UAAA",sourcesContent:["@import 'variables';\n\n.container {\n  position: relative;\n  z-index: $seek-bar-index;\n  width: 100%;\n  height: 22px;\n  cursor: pointer;\n  visibility: hidden;\n\n  &::before {\n    content: '';\n    position: absolute;\n    bottom: 2px;\n    left: 0;\n    width: 100%;\n    background-color: #383838;\n  }\n\n  &.visible {\n    visibility: visible;\n  }\n}\n\n.mouse-preview {\n  position: absolute;\n  bottom: 2px;\n  left: 0;\n  opacity: 0;\n  background-color: rgba(255, 255, 255, 0.3);\n  transition: opacity 50ms ease;\n\n  .container:hover & {\n    opacity: 1;\n  }\n}\n\n.progress {\n  position: absolute;\n  bottom: 2px;\n  left: 0;\n  background-color: #00c1f3;\n}\n\n.thumb {\n  position: absolute;\n  top: 50%;\n  right: 0;\n  opacity: 0;\n  transform: translate(50%, -50%);\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background-color: #fff;\n  transition: opacity 50ms ease;\n\n  .container:hover &,\n  .scrubbing & {\n    opacity: 1;\n  }\n}\n\n.ad-marker {\n  position: absolute;\n  bottom: 2px;\n  width: 2px;\n  background-color: yellow;\n}\n\n.buffer {\n  position: absolute;\n  bottom: 2px;\n  left: 0;\n  background-color: #858585;\n}\n\n.tooltip {\n  position: relative;\n}\n\n.tooltip-container {\n  position: absolute;\n  z-index: $seek-bar-tooltip-index;\n  top: 0;\n  left: 50%;\n  transform: translate(-50%, calc(-100% - 13px));\n  padding: 14px 16px;\n  border: solid 1px #383838;\n  border-radius: 5px;\n  background-color: #000;\n  box-shadow: 0 3px 6px rgba(0, 0, 0, 0.16);\n  white-space: nowrap;\n  font-weight: bold;\n  color: #fff;\n  transition: opacity 100ms ease;\n  pointer-events: none;\n}\n\n.tooltip-with-image {\n  padding: 0;\n\n  .tooltip-text {\n    padding: 10px;\n  }\n}\n\n.tooltip-arrow {\n  position: absolute;\n  z-index: $seek-bar-tooltip-index;\n  bottom: 1px;\n  left: 50%;\n  transform: translate(-50%, calc(-100% - 13px));\n\n  &::before {\n    content: '';\n    position: absolute;\n    bottom: -11px;\n    left: 50%;\n    transform: translateX(-11px);\n    width: 0;\n    height: 0;\n    border-top: 11px solid #383838;\n    border-right: 11px solid transparent;\n    border-left: 11px solid transparent;\n  }\n\n  &::after {\n    content: '';\n    position: absolute;\n    bottom: -10px;\n    left: 50%;\n    transform: translateX(-10px);\n    width: 0;\n    height: 0;\n    border-top: 10px solid #000;\n    border-right: 10px solid transparent;\n    border-left: 10px solid transparent;\n  }\n}\n\n.tooltip-image {\n  width: 242px;\n  height: 136px;\n}\n\n.tooltip-text {\n  display: block;\n  text-align: center;\n}\n\n:global(.jasper-player--xlarge) {\n  .container {\n    &::before {\n      height: 5px;\n    }\n  }\n\n  .progress {\n    height: 5px;\n  }\n\n  .buffer {\n    height: 5px;\n  }\n\n  .ad-marker {\n    height: 5px;\n  }\n\n  .mouse-preview {\n    height: 5px;\n  }\n}\n\n:global(.jasper-player--large) {\n  .container {\n    &::before {\n      height: 5px;\n    }\n  }\n\n  .progress {\n    height: 5px;\n  }\n\n  .buffer {\n    height: 5px;\n  }\n\n  .ad-marker {\n    height: 5px;\n  }\n\n  .mouse-preview {\n    height: 5px;\n  }\n\n  .tooltip-image {\n    width: 220px;\n    height: 123px;\n  }\n\n  .tooltip-container {\n    padding: 14px 16px;\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .tooltip-