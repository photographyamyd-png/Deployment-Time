 {\n      fill: currentColor !important;\n    }\n    :global(.icon-button-stroke-hover-color) {\n      stroke: currentColor !important;\n    }\n\n    &::before {\n      opacity: 0;\n    }\n  }\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      border: 4px solid rgba(255, 255, 255, 0.2);\n\n      :global(.icon-button-fill-hover-color) {\n        fill: currentColor !important;\n        transition: fill 400ms ease;\n      }\n      :global(.icon-button-stroke-hover-color) {\n        transition: stroke 400ms ease;\n        stroke: currentColor !important;\n      }\n    }\n  }\n}\n"],sourceRoot:""}]);var s="jasper-player-round-icon-button__container--chySX",u="jasper-player-round-icon-button__button--GUClQ";const l=o},2849:(n,t,e)=>{"use strict";e.d(t,{A:()=>u,L:()=>s});var i=e(1182),r=e.n(i),a=e(2806),o=e.n(a)()(r());o.push([n.id,".jasper-player-season-selector__select--bAqSD{min-width:50%;padding:7px 40px 7px 18px;border-color:rgba(0,0,0,0);border-radius:4px;margin:0;background-color:#383838;background-image:linear-gradient(135deg, white 50%, transparent 50%),linear-gradient(45deg, transparent 50%, white 50%);background-position:calc(100% - 15px) 1em,calc(100% - 20px) 1em,calc(100% - 2.5em) .5em;background-repeat:no-repeat;background-size:5px 5px,5px 5px,1px 1.5em;font-size:22px;color:#fff;-webkit-appearance:none;-moz-appearance:none;appearance:none}.jasper-player--large .jasper-player-season-selector__select--bAqSD{padding:5px 20px 5px 10px;background-position:calc(100% - 5px) 1em,calc(100% - 10px) 1em,calc(100% - 2.5em) .5em;font-size:14px}.jasper-player--medium .jasper-player-season-selector__select--bAqSD{padding:5px 20px 5px 10px;background-position:calc(100% - 5px) 1em,calc(100% - 10px) 1em,calc(100% - 2.5em) .5em;font-size:14px}.jasper-player--small .jasper-player-season-selector__select--bAqSD{padding:4px 20px 4px 6px;background-position:calc(100% - 5px) 1em,calc(100% - 10px) 1em,calc(100% - 2.5em) .5