CA,cAAA",sourcesContent:["@mixin fadeInAnimation {\n  @keyframes fadeIn {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n}\n\n@mixin fadeOutAnimation {\n  @keyframes fadeOut {\n    0% {\n      opacity: 1;\n    }\n    100% {\n      opacity: 0;\n    }\n  }\n}\n\n@mixin fadeOutAnimationWithDisplayNone {\n  @keyframes fadeOutWithDisplayNone {\n    0% {\n      opacity: 1;\n    }\n    100% {\n      display: none;\n      opacity: 0;\n    }\n  }\n}\n","@import './variables';\n@import './mixins';\n\n@include fadeOutAnimationWithDisplayNone();\n@include fadeInAnimation();\n\n.minimized-player {\n  position: absolute;\n  z-index: 3;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  overflow: hidden;\n  width: 100%;\n  height: 100%;\n  border: 0;\n  background-color: transparent;\n  cursor: pointer;\n  pointer-events: none;\n}\n\n.minimized-player-container-expanded {\n  top: 0 !important;\n  right: 0 !important;\n  width: 100% !important;\n  height: 100% !important;\n}\n\n.back-to-video {\n  display: none;\n  position: absolute;\n  z-index: 2;\n  top: 50%;\n  left: 50%;\n  opacity: 0;\n  transform: translate(-50%, -50%);\n  justify-content: center;\n  align-items: center;\n  border-radius: 4px;\n  background-color: #fff;\n  font-weight: 700;\n  color: #000;\n}\n\n.minimized-player:hover .back-to-video,\n.minimized-player:focus-within .back-to-video {\n  opacity: 1;\n  transition: ease 200ms;\n}\n\n.transition-animation {\n  -webkit-transition: width 0.7s, height 0.7s, top 0.7s, right 0.7s; /* stylelint-disable-line */\n  transition: width 0.7s, height 0.7s, top 0.7s, right 0.7s;\n}\n\n.will-change-border {\n  will-change: width, height, top, right;\n}\n\n.fade-in-transition {\n  animation: fadeIn 1s ease-in-out forwards; /* stylelint-disable-line */\n}\n\n.fade-out-transition {\n  animation: fadeOutWithDisplayNone 1s ease-in-out forwards; /* stylelint-disable-line */\n}\n\n.minimized-player-container-border {\n  border: 1px solid #aeaeae;\n  border-radius: 4px;\n  transition: ease 200ms;\n  pointer-events: auto;\n\n  &:focus {\n    border: 1px solid #fff;\n    box-shadow: 0 0 0 3px white;\n  }\n\n  &:hover {\n    border: 1px solid #fff;\n    box-shadow: 0 0 0 3px white;\n  }\n}\n\n:global(.jasper-player--xlarge) {\n  .minimized-player-container-shrunk {\n    top: 40px;\n    right: 40px;\n    left: auto;\n    width: 336px;\n    height: 189px;\n  }\n\n  .back-to-video {\n    width: 115px;\n    height: 32px;\n    font-size: 13px;\n  }\n}\n\n:global(.jasper-player--large) {\n  .minimized-player-container-shrunk {\n    top: 25px;\n    right: 25px;\n    left: auto;\n    width: 256px;\n    height: 144px;\n  }\n\n  .minimized-player-container-border {\n    &:focus {\n      border: 1px solid #fff;\n      box-shadow: 0 0 0 2px white;\n    }\n\n    &:hover {\n      border: 1px solid #fff;\n      box-shadow: 0 0 0 2px white;\n    }\n  }\n\n  .back-to-video {\n    width: 105px;\n    height: 28px;\n    font-size: 12px;\n  }\n}\n\n:global(.jasper-player--medium),\n:global(.jasper-player--small) {\n  .minimized-player-container-shrunk {\n    top: 15px;\n    right: 15px;\n    left: auto;\n    width: 192px;\n    height: 108px;\n  }\n\n  .minimized-player-container-border {\n    &:focus {\n      border: 1px solid #fff;\n      box-shadow: 0 0 0 2px white;\n    }\n\n    &:hover {\n      border: 1px solid #fff;\n      box-shadow: 0 0 0 2px white;\n    }\n  }\n\n  .back-to-video {\n    width: 85px;\n    height: 25px;\n    font-size: 10px;\n  }\n}\n"],sourceRoot:""}]);var s="jasper-player-watch-next-minimized-player-mobile__minimized-player--snlfr",u="jasper-player-watch-next-minimized-player-mobile__minimized-player-container-expanded--HwyaU",l="jasper-player-watch-next-minimized-player-mobile__back-to-video--Smhp1",c="jasper-player-watch-next-minimized-player-mobile__transition-animation--yi0rZ",f="jasper-player-watch-next-minimized-player-mobile__will-change-border--P4EIi",h="jasper-player-watch-next-minimized-player-mobil