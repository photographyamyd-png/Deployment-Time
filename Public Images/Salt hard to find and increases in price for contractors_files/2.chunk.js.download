er--W1IfG button:not(:disabled),.jasper-player-root__container--W1IfG [type=button]:not(:disabled),.jasper-player-root__container--W1IfG [type=reset]:not(:disabled),.jasper-player-root__container--W1IfG [type=submit]:not(:disabled){cursor:pointer}.jasper-player-root__container--W1IfG [role=button]{cursor:pointer}.jasper-player-root__float--p7vTN{position:fixed;z-index:9999;overflow:hidden}.jasper-player-root__enforce-sized-container--pmsN3{width:100%;height:100%}.jasper-player-root__probably-keyboard-focus--dYEAX *:focus{outline:2px solid rgba(27,127,204,.8)}.jasper-player-root__probably-keyboard-focus--dYEAX #jasper-ad-overlay:focus::after,.jasper-player-root__probably-keyboard-focus--dYEAX #jasper-ad-small-overlay:focus::after,.jasper-player-root__probably-keyboard-focus--dYEAX #jasper-player-overlay:focus::after{content:"";position:absolute;z-index:9999;top:0;right:0;bottom:0;left:0;outline:3px solid rgba(27,127,204,.8);outline-offset:-3px;pointer-events:none}',"",{version:3,sources:["webpack://./kotlin/styles/root.module.scss","webpack://./kotlin/styles/_variables.scss"],names:[],mappings:"AAGA,sCACE,aAAA,CACA,iBAAA,CACA,eAAA,CACA,UAAA,CACA,sBAAA,CACA,YAAA,CACA,iBAAA,CACA,cAAA,CACA,eAAA,CACA,eAAA,CACA,wBAAA,CAAA,qBAAA,CAAA,gBAAA,CAEA,8EACE,iBAAA,CAGF,mCACE,8EACE,iBAAA,CAGF,sFACE,UAAA,CACA,kBAAA,CACA,UAAA,CAGF,qFACE,aAAA,CACA,UAAA,CACA,UAAA,CAAA,CAIJ,8CACE,YAAA,CAGF,uIAGE,qBAAA,CAGF,oOAKE,mBAAA,CACA,iBAAA,CACA,mBAAA,CAGF,oFAEE,qBAAA,CAGF,oQAIE,cAAA,CAGF,oDACE,cAAA,CAIJ,kCACE,cAAA,CACA,YC5CY,CD6CZ,eAAA,CAGF,oDACE,UAAA,CACA,WAAA,CAKA,4DACE,qCAAA,CAGF,sQAGE,UAAA,CACA,iBAAA,CACA,YC/DkB,CDgElB,KAAA,CACA,OAAA,CACA,QAAA,CACA,MAAA,CACA,qCAAA,CACA,mBAAA,CACA,mBAAA",sourcesContent:["@import 'variables';\n@import 'fonts';\n\n.container {\n  display: block;\n  position: relative;\n  overflow: hidden;\n  width: 100%;\n  height: auto !important;\n  min-height: 0;\n  font-family: Arial;\n  font-size: 1rem;\n  font-weight: 400;\n  line-height: 1.5;\n  user-select: none;\n\n  &.aspect-ratio {\n    aspect-ratio: 16 / 9;\n  }\n\n  @supports not (aspect-ratio: 16 / 9) {\n    &.aspect-ratio {\n      aspect-ratio: auto;\n    }\n\n    &.aspect-ratio::before {\n      content: '';\n      padding-top: 56.25%;\n      float: left;\n    }\n\n    &.aspect-ratio::after {\n      display: block;\n      content: '';\n      clear: both;\n    }\n  }\n\n  *:focus {\n    outline: none;\n  }\n\n  *,\n  *::before,\n  *::after {\n    box-sizing: border-box;\n  }\n\n  input,\n  button,\n  select,\n  optgroup,\n  textarea {\n    font-family: inherit;\n    font-size: inherit;\n    line-height: inherit;\n  }\n\n  img,\n  svg {\n    vertical-align: middle;\n  }\n\n  button:not(:disabled),\n  [type='button']:not(:disabled),\n  [type='reset']:not(:disabled),\n  [type='submit']:not(:disabled) {\n    cursor: pointer;\n  }\n\n  [role='button'] {\n    cursor: pointer;\n  }\n}\n\n.float {\n  position: fixed;\n  z-index: $float-index;\n  overflow: hidden;\n}\n\n.enforce-sized-container {\n  width: 100%;\n  height: 100%;\n}\n\n// We must create an outline for the player and ad overlay on focus due to the overflow-hidden of the root container\n.probably-keyboard-focus {\n  *:focus {\n    outline: 2px solid rgb(27 127 204 / 80%);\n  }\n\n  :global(#jasper-ad-overlay):focus::after,\n  :global(#jasper-ad-small-overlay):focus::after,\n  :global(#jasper-player-overlay):focus::after {\n    content: '';\n    position: absolute;\n    z-index: $overlay-focus-index;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    outline: 3px solid rgb(27 127 204 / 80%);\n    outline-offset: -3px;\n    pointer-events: none;\n  }\n}\n","$ad-break-overlay-index: 2;\n$banner-ad-overlay-index: 3;\n$blackout-overlay-index: 5;\n$cast-overlay-index: 1;\n$debug-overlay-index: 16;\n$end-screen-overlay-index: 2;\n$error-overlay-index: 11;\n$loading-overlay-index: 10;\n$pause-ad-overlay-index: 2;\n$popover-dialog-overlay-index: 4;\n$preview-overlay-index: 10;\n$skip-breaks-overlay-index: 2;\n$text-tra