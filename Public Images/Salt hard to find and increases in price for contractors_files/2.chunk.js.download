 display: flex;\n  align-items: center;\n}\n\n.tab-selector-button {\n  display: none;\n  position: relative;\n  padding: 0;\n  border: 0;\n  background-color: transparent;\n  color: #00c1f3;\n  appearance: none;\n\n  :global(.icon-button-fill-hover-color) {\n    fill: #858585 !important;\n  }\n\n  svg {\n    display: block;\n  }\n\n  &.tab-selector-button-visible {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n  }\n\n  &.tab-selector-button-active {\n    :global(.icon-button-fill-hover-color) {\n      fill: #fff !important;\n    }\n\n    &::after {\n      display: block;\n      content: '';\n      position: absolute;\n      left: 50%;\n      transform: translateX(-50%);\n      background-color: #fff;\n    }\n  }\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      :global(.icon-button-fill-hover-color) {\n        fill: currentColor !important;\n      }\n    }\n  }\n}\n\n.playback-speed-button {\n  display: flex;\n  position: relative;\n  justify-content: center;\n  align-items: center;\n  padding: 5px 3px;\n  border: 0;\n  border-radius: 8px;\n  background-clip: content-box;\n  background-color: #fff;\n  font-size: 14px;\n  color: #858585;\n  appearance: none;\n\n  &.playback-speed-button-active {\n    color: #000 !important;\n  }\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      color: #00c1f3 !important;\n    }\n  }\n}\n\n.tab-title {\n  width: fit-content;\n  text-transform: uppercase;\n  color: #858585;\n}\n\n.tab-content-list {\n  width: 100%;\n  margin: 0;\n  list-style: none;\n  text-align: left;\n  font-weight: bold;\n  color: #858585;\n}\n\n.tab-content-list-item {\n  position: relative;\n  white-space: nowrap;\n  transition: color 50ms ease;\n  cursor: pointer;\n\n  &.tab-content-list-item-selected {\n    &::before {\n      content: '';\n      position: absolute;\n      top: 50%;\n      transform: translateY(-50%);\n      border-radius: 50%;\n      background-color: #fff;\n    }\n  }\n}\n\n.unavailable {\n  padding: 50px 20px;\n  text-align: center;\n  color: #fff;\n}\n\n.copy-link-button-container {\n  display: flex;\n  position: relative;\n  justify-content: flex-start;\n  align-items: center;\n\n  &.hidden {\n    display: none;\n  }\n}\n\n.copy-link-success-message {\n  position: relative;\n  opacity: 0;\n  border: solid 1px #383838;\n  border-radius: 5px;\n  margin-left: 20px;\n  background-color: #000;\n  box-shadow: 0 3px 6px rgba(0, 0, 0, 0.16);\n  white-space: nowrap;\n  font-weight: bold;\n  color: #fff;\n  pointer-events: none;\n\n  &::before {\n    content: '';\n    position: absolute;\n    top: 50%;\n    left: -11px;\n    transform: translateY(-11px);\n    width: 0;\n    height: 0;\n    border-top: 11px solid transparent;\n    border-right: 11px solid #383838;\n    border-bottom: 11px solid transparent;\n  }\n\n  &::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    left: -10px;\n    transform: translateY(-10px);\n    width: 0;\n    height: 0;\n    border-top: 10px solid transparent;\n    border-right: 10px solid #000;\n    border-bottom: 10px solid transparent;\n  }\n\n  &.copy-link-success-message-visible {\n    opacity: 1;\n    transition: opacity 100ms ease;\n  }\n}\n\n.text-button {\n  padding: 0;\n  border: 0;\n  margin: 0;\n  background-color: transparent;\n  text-align: left;\n  font-weight: bold;\n  color: #858585;\n  transition: color 75ms ease;\n  appearance: none;\n  cursor: pointer;\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      color: #fff;\n    }\n  }\n\n  &.text-button-selected {\n    color: #fff;\n  }\n}\n\n.share-social-media {\n  text-decoration: none;\n  font-weight: bold;\n  color: #858585;\n  transition: color 75ms ease;\n\n  /* Device that can hover (desktops) */\n  @media (hover: hover) and (pointer: fine) {\n    &:hover {\n      color: #fff;\n    }\n  }\n}\n\n:global(.jasper-player--xlarge) {\n  .tab-selector-container {\n    padding: 27px 40px 23px 29px;\n  }\n\n  .tab-selector-button {\n    margin-right: 18px;\n\n    &.tab-selector-button-active {\n      &::after {\n        bottom: -6px;\n        width: 35px;\n        height: 3px;\n      }\n    }\n\n    &.playback-speed-active {\n      &::after {\n        bottom: -18px;\n        width: 35px;\n        height: 3px;\n      }\n    }\n  }\n\n  .tab-content {\n    padding: 45px 50px 50px;\n  }\n\n  .tab-title {\n    font-size: 16px;\n    line-height: 1.13;\n    letter-spacing: 1.6px;\n  }\n\n  .tab-content-list {\n    padding: 30px 50px 0 0;\n    font-size: 18px;\n    line-height: 1.17;\n  }\n\n  .tab-content-list-item {\n    margin-bottom: 30px;\n\n    &:last-child {\n      margin: 0;\n    }\n\n    &.tab-content-list-item-selected {\n      &::before {\n        left: -24px;\n        width: 9px;\n        height: 9px;\n      }\n    }\n  }\n\n  .copy-link-success-message {\n    padding: 15px 17px;\n    font-size: 18px;\n    line-height: 1.17;\n  }\n\n  .text-button {\n    font-size: 18px;\n    line-height: 1.17;\n  }\n\n  .copy-link-button-container {\n    &:first-child {\n      margin-top: -16px;\n    }\n  }\n\n  .share-social-media {\n    margin: 16px 0;\n    font-size: 18px;\n    line-height: 1.17;\n  }\n\n  .tab-icons {\n    width: 44px;\n    height: 44px;\n  }\n}\n\n:global(.jasper-player--large) {\n  .tab-selector-container {\n    padding: 20px 30px 20px 22px;\n  }\n\n  .tab-selector-button {\n    margin-right: 15px;\n\n    &.tab-selector-button-active {\n      &::after {\n        bottom: -3px;\n        width: 30px;\n        height: 2px;\n      }\n    }\n  }\n\n  .tab-content {\n    padding: 31px 38px 40px;\n  }\n\n  .tab-title {\n    font-size: 11px;\n    line-height: 1.09;\n    letter-spacing: 1.1px;\n  }\n\n  .tab-content-list {\n    padding: 21px 0 0;\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .tab-content-list-item {\n    margin-bottom: 21px;\n\n    &:last-child {\n      margin: 0;\n    }\n\n    &.tab-content-list-item-selected {\n      &::before {\n        left: -15px;\n        width: 7px;\n        height: 7px;\n      }\n    }\n  }\n\n  .copy-link-success-message {\n    padding: 10px 12px;\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .text-button {\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .copy-link-button-container {\n    &:first-child {\n      margin-top: -11px;\n    }\n  }\n\n  .share-social-media {\n    margin: 11px 0;\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .tab-icons {\n    width: 38px;\n    height: 38px;\n  }\n}\n\n:global(.jasper-player--medium) {\n  .tab-selector-container {\n    padding: 20px 30px 20px 22px;\n  }\n\n  .tab-selector-button {\n    margin-right: 15px;\n\n    &.tab-selector-button-active {\n      &::after {\n        bottom: -3px;\n        width: 30px;\n        height: 2px;\n      }\n    }\n  }\n\n  .tab-content {\n    padding: 31px 38px 40px;\n  }\n\n  .tab-title {\n    font-size: 11px;\n    line-height: 1.09;\n    letter-spacing: 1.1px;\n  }\n\n  .tab-content-list {\n    padding: 21px 0 0;\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .tab-content-list-item {\n    margin-bottom: 21px;\n\n    &:last-child {\n      margin: 0;\n    }\n\n    &.tab-content-list-item-selected {\n      &::before {\n        left: -15px;\n        width: 7px;\n        height: 7px;\n      }\n    }\n  }\n\n  .copy-link-success-message {\n    padding: 10px 12px;\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .text-button {\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .copy-link-button-container {\n    &:first-child {\n      margin-top: -11px;\n    }\n  }\n\n  .share-social-media {\n    margin: 11px 0;\n    font-size: 16px;\n    line-height: 1.13;\n  }\n\n  .tab-icons {\n    width: 38px;\n    height: 38px;\n  }\n}\n\n:global(.jasper-player--small) {\n  .tab-selector-container {\n    padding: 12px 25px 12px 12px;\n  }\n\n  .playback-sp